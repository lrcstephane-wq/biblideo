<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Biblideo</AssemblyName>
    <RootNamespace>Biblideo.App</RootNamespace>
    <StartupObject>Biblideo.App.Program</StartupObject>
    <Version>1.6.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Biblideo.Core\Biblideo.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\*.png" />
  </ItemGroup>
</Project>
