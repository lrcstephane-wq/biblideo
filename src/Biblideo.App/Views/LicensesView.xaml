<UserControl x:Class="Biblideo.App.Views.LicensesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2.1*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#102B4B" BorderBrush="#245D93" BorderThickness="1" CornerRadius="13" Padding="20,16" Margin="0,0,12,0"><StackPanel><TextBlock Text="PILOTAGE DES LICENCES" Style="{StaticResource EyebrowText}"/><TextBlock Text="Du mail TopSolid au bon client, sans partie de cache-cache" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock x:Name="ScanSummaryText" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0"/></StackPanel></Border>
            <Button Grid.Column="1" Tag="Inbox" Click="SummaryFilter_Click" Margin="0,0,10,0" Padding="15" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="À DISTRIBUER" Style="{StaticResource EyebrowText}"/><TextBlock x:Name="InboxCountText" Text="0" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Button>
            <Button Grid.Column="2" Tag="Matched" Click="SummaryFilter_Click" Margin="0,0,10,0" Padding="15" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="IDENTIFIÉES" Foreground="{StaticResource SuccessBrush}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="MatchedCountText" Text="0" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Button>
            <Button Grid.Column="3" Tag="Unmatched" Click="SummaryFilter_Click" Margin="0,0,10,0" Padding="15" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="À IDENTIFIER" Foreground="#C68BE3" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="UnmatchedCountText" Text="0" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Button>
            <Button Grid.Column="4" Tag="RenewSoon" Click="SummaryFilter_Click" Margin="0,0,10,0" Padding="15" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="À RENOUVELER" Foreground="{StaticResource WarningBrush}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="RenewCountText" Text="0" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Button>
            <Button Grid.Column="5" Tag="Attention" Click="SummaryFilter_Click" Padding="15" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="À VÉRIFIER" Foreground="#EF7777" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="AttentionCountText" Text="0" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Button>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource ModernPanel}" Padding="12" Margin="0,14,0,12"><Grid><StackPanel Orientation="Horizontal"><Button x:Name="InboxTabButton" Content="▣  Boîte d’arrivée" Style="{StaticResource PrimaryButton}" Click="InboxTab_Click" Margin="0,0,8,0"/><Button x:Name="TrackingTabButton" Content="◷  Suivi des clients" Click="TrackingTab_Click"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="↗ TopSolid Web Planner" Click="OpenPlanner_Click" Margin="0,0,8,0"/><Button Content="↻ Actualiser" Click="Refresh_Click"/></StackPanel></Grid></Border>

        <Grid Grid.Row="2">
            <Grid x:Name="InboxPanel"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Background="#15253A" BorderBrush="#315274" BorderThickness="1" CornerRadius="10" Padding="14,11" Margin="0,0,0,10"><Grid><StackPanel><TextBlock Text="NOUVEAUX MAILS .MSG" Style="{StaticResource EyebrowText}"/><TextBlock Text="Les correspondances sont proposées depuis les adresses enregistrées dans Clients." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Tout cocher" Click="SelectAllInbox_Click" Margin="0,0,8,0"/><Button Content="Tout décocher" Click="UnselectAllInbox_Click"/></StackPanel></Grid></Border>
                <Border Grid.Row="1" Style="{StaticResource ModernPanel}" Padding="8"><Grid><TextBlock x:Name="InboxEmptyText" Text="La boîte est vide. Pour une fois, personne ne réclame de licence." Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <ListBox x:Name="InboxList" ItemsSource="{Binding InboxRows}" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,7"/><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate><Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,11"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="125"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="18" Height="18"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subject}" Foreground="{StaticResource SubtleBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="DESTINATAIRE" Style="{StaticResource EyebrowText}"/><TextBlock Text="{Binding Recipients}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                            <StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock Text="ÉCHÉANCE" Style="{StaticResource EyebrowText}"/><TextBlock Text="{Binding ExpiryDisplay}" Margin="0,4,0,0"/></StackPanel>
                            <StackPanel Grid.Column="4" VerticalAlignment="Center"><TextBlock Text="{Binding ClientDisplay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding MatchDisplay}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                            <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="⌕" ToolTip="Ouvrir le mail" Tag="{Binding}" Click="OpenMessage_Click" Width="40" Padding="8"/><Button Content="Associer" ToolTip="Choisir ou modifier le client" Tag="{Binding}" Click="Assign_Click" Margin="7,0,0,0"/></StackPanel>
                        </Grid></Border></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </Grid></Border>
                <Border Grid.Row="2" Background="#1B3B5E" BorderBrush="#397AC0" BorderThickness="1" CornerRadius="10" Padding="14,11" Margin="0,11,0,0"><Grid><StackPanel><TextBlock x:Name="DispatchSummaryText" Text="Sélectionne les mails à distribuer." FontWeight="SemiBold"/><TextBlock Text="Copie contrôlée, vérification d’intégrité, puis retrait de la boîte d’arrivée." Foreground="#AFC7E3" FontSize="10" Margin="0,3,0,0"/></StackPanel><Button x:Name="DispatchButton" Content="Distribuer la sélection  →" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="Dispatch_Click"/></Grid></Border>
            </Grid>

            <Grid x:Name="TrackingPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Style="{StaticResource ModernPanel}" Padding="12" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions><Grid><TextBox x:Name="TrackingSearchText" TextChanged="TrackingFilterChanged" Padding="34,8,11,8"/><TextBlock Text="⌕" FontSize="20" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,1" IsHitTestVisible="False"/></Grid><ComboBox x:Name="TrackingStatusFilter" Grid.Column="1" Margin="10,0,0,0" SelectionChanged="TrackingFilterChanged"><ComboBoxItem Content="Tous les états" Tag="All"/><ComboBoxItem Content="Valides" Tag="Valid"/><ComboBoxItem Content="À renouveler" Tag="RenewSoon"/><ComboBoxItem Content="Expirées" Tag="Expired"/><ComboBoxItem Content="Sans licence" Tag="Missing"/><ComboBoxItem Content="Toutes les alertes" Tag="Attention"/><ComboBoxItem Content="À vérifier" Tag="Unreadable"/><ComboBoxItem Content="Hors mise à jour" Tag="OffSubscription"/></ComboBox></Grid></Border>
                <Border Grid.Row="1" Style="{StaticResource ModernPanel}" Padding="8"><Grid><TextBlock x:Name="TrackingEmptyText" Text="Aucun client ne correspond à ce filtre." Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <ListBox x:Name="TrackingList" ItemsSource="{Binding TrackingRows}" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,7"/><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate><Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,11"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="40" Height="40" CornerRadius="20" Background="#21466F"><TextBlock Text="{Binding Initials}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#A9D1FF"/></Border><TextBlock Grid.Column="1" Text="{Binding ClientName}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Border Grid.Column="2" Background="#263F5E" BorderBrush="#3F6289" BorderThickness="1" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding Variant}" Foreground="#A9D1FF" FontWeight="Bold"/></Border><StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock Text="ÉCHÉANCE" Style="{StaticResource EyebrowText}"/><TextBlock Text="{Binding ExpiryDisplay}" Margin="0,4,0,0" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="4" VerticalAlignment="Center"><TextBlock Text="ÉTAT" Style="{StaticResource EyebrowText}"/><TextBlock Text="{Binding StateDisplay}" Foreground="{Binding StateColor}" Margin="0,4,0,0" FontWeight="Bold"/><TextBlock Text="{Binding DaysDisplay}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="5" VerticalAlignment="Center"><TextBlock Text="ARCHIVES" Style="{StaticResource EyebrowText}"/><TextBlock Text="{Binding MessageDisplay}" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="6" Content="⌕ Ouvrir" ToolTip="Ouvrir le dossier des licences" Tag="{Binding}" Click="OpenClientLicenseFolder_Click" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </Grid></Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
