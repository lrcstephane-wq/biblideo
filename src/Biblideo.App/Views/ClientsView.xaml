<UserControl x:Class="Biblideo.App.Views.ClientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Biblideo.App.Controls">
    <UserControl.Resources>
        <ItemsPanelTemplate x:Key="ClientListItemsPanel"><VirtualizingStackPanel/></ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="ClientCardItemsPanel"><controls:VirtualizingWrapPanel TargetItemWidth="350" ItemHeight="250" Spacing="10"/></ItemsPanelTemplate>

        <Style x:Key="ClientListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,7"/><Setter Property="Background" Value="Transparent"/><Setter Property="Focusable" Value="True"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ClientCardItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource ClientListItemStyle}"><Setter Property="Margin" Value="0"/><Setter Property="Height" Value="250"/></Style>

        <DataTemplate x:Key="ClientListTemplate">
            <Border x:Name="RowCard" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,11">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="82"/><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="178"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="20" Background="#21466F" VerticalAlignment="Center"><TextBlock Text="{Binding Initials}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#A9D1FF"/></Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding FolderName}" Foreground="{StaticResource SubtleBrush}" FontSize="10" FontFamily="Consolas" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel>
                    <Border Grid.Column="2" Background="#263F5E" BorderBrush="#3F6289" BorderThickness="1" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding VariantLabel}" Foreground="#A9D1FF" FontWeight="Bold" FontSize="11"/></Border>
                    <StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock Text="DERNIER DÉPLOIEMENT" Style="{StaticResource EyebrowText}"/><TextBlock Text="{Binding LatestDeployment}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                    <StackPanel Grid.Column="4" VerticalAlignment="Center"><TextBlock Text="LICENCES · MAILS" Style="{StaticResource EyebrowText}"/><TextBlock Text="{Binding EmailSummary}" Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
                    <StackPanel Grid.Column="5" VerticalAlignment="Center"><TextBlock Text="STRUCTURE" Style="{StaticResource EyebrowText}"/><TextBlock Text="{Binding StructureLabel}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/><Button Tag="{Binding}" Click="Repair_Click" Padding="7,3" HorizontalAlignment="Left" Margin="0,5,0,0" FontSize="10"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Content" Value="Réparer"/><Style.Triggers><DataTrigger Binding="{Binding CanRepairStructure}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel>
                    <StackPanel Grid.Column="6" VerticalAlignment="Center" HorizontalAlignment="Center"><ToggleButton IsChecked="{Binding DesiredSubscribed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SwitchToggle}" Click="SubscriptionToggle_Click"/><TextBlock Text="{Binding StatusLabel}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" HorizontalAlignment="Center"/></StackPanel>
                    <StackPanel Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="▣" ToolTip="Ouvrir le dossier client" Tag="{Binding}" Click="OpenFolder_Click" Width="42" Padding="9,6"/><Button Content="✎" ToolTip="Modifier la fiche client" Tag="{Binding}" Click="EditClient_Click" Width="42" Padding="9,6" Margin="6,0,0,0"/><Button Content="🗃" ToolTip="Archiver ou retirer le client" Tag="{Binding}" Click="RemoveClient_Click" Width="42" Padding="9,6" Margin="6,0,0,0" Foreground="{StaticResource WarningBrush}"/></StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers><DataTrigger Binding="{Binding HasPendingChange}" Value="True"><Setter TargetName="RowCard" Property="Background" Value="#382F25"/><Setter TargetName="RowCard" Property="BorderBrush" Value="#C88946"/></DataTrigger><DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True"><Setter TargetName="RowCard" Property="Background" Value="#243B55"/><Setter TargetName="RowCard" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter TargetName="RowCard" Property="BorderThickness" Value="2"/></DataTrigger></DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="ClientCardTemplate">
            <Border x:Name="ClientCard" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="15">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="20" Background="#21466F"><TextBlock Text="{Binding Initials}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#A9D1FF"/></Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding FolderName}" Foreground="{StaticResource SubtleBrush}" FontSize="9" FontFamily="Consolas" TextTrimming="CharacterEllipsis" Margin="0,3,8,0"/></StackPanel>
                        <Border Grid.Column="2" Background="#263F5E" BorderBrush="#3F6289" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Top"><TextBlock Text="{Binding VariantLabel}" Foreground="#A9D1FF" FontWeight="Bold" FontSize="10"/></Border>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0"><TextBlock Text="DERNIER DÉPLOIEMENT" Style="{StaticResource EyebrowText}"/><TextBlock Text="{Binding LatestDeployment}" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="STRUCTURE" Style="{StaticResource EyebrowText}"/><TextBlock Text="{Binding StructureLabel}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/><Button Tag="{Binding}" Click="Repair_Click" Padding="6,2" HorizontalAlignment="Left" Margin="0,4,0,0" FontSize="9"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Content" Value="Réparer"/><Style.Triggers><DataTrigger Binding="{Binding CanRepairStructure}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel>
                    </Grid>
                    <Border Grid.Row="2" Background="#19283A" CornerRadius="8" Padding="10,8" Margin="0,12,0,0" VerticalAlignment="Top"><StackPanel><TextBlock Text="LICENCES · MAILS" Style="{StaticResource EyebrowText}"/><TextBlock Text="{Binding EmailSummary}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
                    <Grid Grid.Row="3" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><ToggleButton IsChecked="{Binding DesiredSubscribed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SwitchToggle}" Click="SubscriptionToggle_Click"/><TextBlock Text="{Binding StatusLabel}" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="▣" ToolTip="Ouvrir le dossier client" Tag="{Binding}" Click="OpenFolder_Click" Width="36" Padding="7,5"/><Button Content="✎" ToolTip="Modifier la fiche client" Tag="{Binding}" Click="EditClient_Click" Width="36" Padding="7,5" Margin="5,0,0,0"/><Button Content="🗃" ToolTip="Archiver ou retirer le client" Tag="{Binding}" Click="RemoveClient_Click" Width="36" Padding="7,5" Margin="5,0,0,0" Foreground="{StaticResource WarningBrush}"/></StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers><DataTrigger Binding="{Binding HasPendingChange}" Value="True"><Setter TargetName="ClientCard" Property="Background" Value="#382F25"/><Setter TargetName="ClientCard" Property="BorderBrush" Value="#C88946"/></DataTrigger><DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True"><Setter TargetName="ClientCard" Property="Background" Value="#243B55"/><Setter TargetName="ClientCard" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter TargetName="ClientCard" Property="BorderThickness" Value="2"/></DataTrigger></DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#102B4B" BorderBrush="#245D93" BorderThickness="1" CornerRadius="13" Padding="20,16" Margin="0,0,12,0"><StackPanel><TextBlock Text="PORTEFEUILLE CLIENTS" Style="{StaticResource EyebrowText}"/><TextBlock Text="Qui reçoit quoi, sans jouer à cache-cache avec les dossiers" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock x:Name="ScanSummaryText" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0"/></StackPanel></Border>
            <Button Grid.Column="1" Tag="All" Click="ClientSummary_Click" Padding="15" Margin="0,0,10,0" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="CLIENTS" Style="{StaticResource EyebrowText}"/><TextBlock x:Name="TotalCountText" Text="0" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Button>
            <Button Grid.Column="2" Tag="Subscribed" Click="ClientSummary_Click" Padding="15" Margin="0,0,10,0" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="SOUS MAJ" Foreground="{StaticResource SuccessBrush}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="SubscribedCountText" Text="0" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Button>
            <Button Grid.Column="3" Tag="Unsubscribed" Click="ClientSummary_Click" Padding="15" Margin="0,0,10,0" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="HORS MAJ" Foreground="{StaticResource WarningBrush}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="UnsubscribedCountText" Text="0" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Button>
            <Button Grid.Column="4" Tag="Warning" Click="ClientSummary_Click" Padding="15" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="À VÉRIFIER" Foreground="#EF7777" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="WarningCountText" Text="0" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Button>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource ModernPanel}" Padding="13" Margin="0,14,0,12">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid><TextBox x:Name="SearchText" TextChanged="FilterChanged" Padding="34,8,11,8"/><TextBlock Text="⌕" FontSize="20" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,1" IsHitTestVisible="False"/></Grid>
                <ComboBox x:Name="StatusFilter" Grid.Column="1" Margin="10,0,0,0" SelectionChanged="FilterChanged"><ComboBoxItem Content="Tous les statuts" Tag="All"/><ComboBoxItem Content="Sous MAJ" Tag="Subscribed"/><ComboBoxItem Content="Hors MAJ" Tag="Unsubscribed"/><ComboBoxItem Content="À vérifier" Tag="Warning"/><ComboBoxItem Content="Structure à réparer" Tag="Structure"/><ComboBoxItem Content="Mail manquant" Tag="Email"/></ComboBox>
                <ComboBox x:Name="VariantFilter" Grid.Column="2" Margin="10,0,0,0" SelectionChanged="FilterChanged"><ComboBoxItem Content="Toutes les versions" Tag="All"/><ComboBoxItem Content="SC" Tag="SC"/><ComboBoxItem Content="EP" Tag="EP"/><ComboBoxItem Content="SC + EP" Tag="SC_EP"/></ComboBox>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="10,0,0,0"><Button x:Name="ClientListViewButton" Content="☷ Liste" ToolTip="Afficher les clients en lignes détaillées" Click="ClientListViewButton_Click" Padding="10,7"/><Button x:Name="ClientCardViewButton" Content="▦ Cartes" ToolTip="Afficher les clients sous forme de cartes" Click="ClientCardViewButton_Click" Padding="10,7" Margin="6,0,0,0"/></StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="10,0,0,0"><Button Content="↻ Actualiser" Click="Refresh_Click" Margin="0,0,8,0"/><Button Content="Archives" Click="Archives_Click" Margin="0,0,8,0"/><Button Content="＋ Nouveau client" Style="{StaticResource PrimaryButton}" Click="NewClient_Click"/></StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ModernPanel}" Padding="8">
            <Grid><TextBlock x:Name="EmptyText" Text="Aucun client ne correspond aux filtres." Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                <ListBox x:Name="ClientsList" ItemsSource="{Binding}" SelectionChanged="ClientsList_SelectionChanged" ItemContainerStyle="{StaticResource ClientListItemStyle}" ItemTemplate="{StaticResource ClientListTemplate}" ItemsPanel="{StaticResource ClientListItemsPanel}" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"/>
            </Grid>
        </Border>

        <Border x:Name="PendingBar" Grid.Row="3" Background="#1B3B5E" BorderBrush="#397AC0" BorderThickness="1" CornerRadius="10" Padding="14,11" Margin="0,12,0,0" Visibility="Collapsed"><Grid><StackPanel VerticalAlignment="Center"><TextBlock x:Name="PendingTitle" FontWeight="SemiBold"/><TextBlock Text="Les dossiers ne seront renommés qu’après validation." Foreground="#AFC7E3" FontSize="10" Margin="0,3,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Annuler les changements" Click="CancelPending_Click" Margin="0,0,8,0"/><Button Content="Appliquer les modifications" Style="{StaticResource PrimaryButton}" Click="ApplyPending_Click"/></StackPanel></Grid></Border>

        <Border x:Name="ClientDetailsPanel" Grid.RowSpan="4" Width="440" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="#162333" BorderBrush="#52759A" BorderThickness="1" CornerRadius="14" Visibility="Collapsed" Panel.ZIndex="20">
            <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.5"/></Border.Effect>
            <Grid><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Background="{StaticResource HeaderBrush}" CornerRadius="14,14,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"><Grid Margin="20,0,12,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="34" Height="34" CornerRadius="17" Background="#21466F"><TextBlock Text="{Binding Initials}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#A9D1FF" FontWeight="Bold"/></Border><StackPanel Margin="11,0,0,0"><TextBlock Text="FICHE CLIENT" Style="{StaticResource EyebrowText}"/><TextBlock Text="{Binding DisplayName}" FontSize="17" FontWeight="SemiBold"/></StackPanel></StackPanel><Button Content="×" Click="CloseClientDetails_Click" HorizontalAlignment="Right" Width="34" Height="30" Padding="0" Background="Transparent" BorderBrush="Transparent" FontSize="18"/></Grid></Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="DOSSIER" Style="{StaticResource EyebrowText}"/><TextBlock Text="{Binding FolderName}" FontFamily="Consolas" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel><Border Grid.Column="1" Background="#263F5E" BorderBrush="#3F6289" BorderThickness="1" CornerRadius="6" Padding="9,4" VerticalAlignment="Top"><TextBlock Text="{Binding VariantLabel}" Foreground="#A9D1FF" FontWeight="Bold"/></Border></Grid>
                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="14" Margin="0,16,0,0"><StackPanel><TextBlock Text="ABONNEMENT" Style="{StaticResource EyebrowText}"/><TextBlock Text="{Binding StatusLabel}" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="La modification reste en attente tant qu’elle n’est pas appliquée." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                    <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="14" Margin="0,0,5,0"><StackPanel><TextBlock Text="DERNIER DÉPLOIEMENT" Style="{StaticResource EyebrowText}"/><TextBlock Text="{Binding LatestDeployment}" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></Border><Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="14" Margin="5,0,0,0"><StackPanel><TextBlock Text="LICENCE" Style="{StaticResource EyebrowText}"/><TextBlock x:Name="ClientLicenseExpiryText" Text="Analyse…" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock x:Name="ClientLicenseStateText" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0"/></StackPanel></Border></Grid>
                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="14" Margin="0,10,0,0"><StackPanel><TextBlock Text="ADRESSES LICENCE" Style="{StaticResource EyebrowText}"/><ItemsControl ItemsSource="{Binding Client.Emails}" Margin="0,7,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="0,0,0,4" Foreground="#C6D8EB"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock x:Name="NoClientEmailText" Text="Aucune adresse renseignée" Foreground="{StaticResource WarningBrush}" FontStyle="Italic"/></StackPanel></Border>
                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="14" Margin="0,10,0,0"><StackPanel><TextBlock Text="STRUCTURE" Style="{StaticResource EyebrowText}"/><TextBlock Text="{Binding StructureLabel}" FontWeight="SemiBold" Margin="0,5,0,0"/><ItemsControl ItemsSource="{Binding Client.MissingFolders}" Margin="0,6,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="•  {Binding}" Foreground="{StaticResource WarningBrush}" FontSize="10"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                    <TextBlock Text="ACTIVITÉ RÉCENTE" Style="{StaticResource EyebrowText}" Margin="0,16,0,8"/><ItemsControl x:Name="ClientHistoryList"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding When}" Foreground="{StaticResource SubtleBrush}" FontFamily="Consolas"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel></ScrollViewer>
                <Border Grid.Row="2" Background="#141F2D" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,14,14" Padding="14"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="▣ Ouvrir" ToolTip="Ouvrir le dossier client" Tag="{Binding}" Click="OpenFolder_Click"/><Button Content="✎ Modifier" ToolTip="Modifier la fiche client" Tag="{Binding}" Click="EditClient_Click" Margin="7,0,0,0"/><Button Content="🗃 Archiver" ToolTip="Archiver ou retirer le client" Tag="{Binding}" Click="RemoveClient_Click" Margin="7,0,0,0" Foreground="{StaticResource WarningBrush}"/></StackPanel></Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
