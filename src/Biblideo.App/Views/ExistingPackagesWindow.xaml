<Window x:Class="Biblideo.App.Views.ExistingPackagesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Packages produit existants" Width="980" Height="720" MinWidth="780" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="*" /><RowDefinition Height="14" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Background="#153F72" BorderBrush="#4D8BD4" BorderThickness="1" CornerRadius="15" Padding="22">
            <Grid><StackPanel><TextBlock Text="PACKAGES À DÉPLOYER" Style="{StaticResource EyebrowText}" Foreground="#A9D0FF" /><TextBlock Text="Modifier ou mettre un package en corbeille" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" /><TextBlock x:Name="SummaryText" Foreground="#C5D8ED" Margin="0,6,0,0" /></StackPanel><TextBox x:Name="SearchText" Width="300" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Rechercher par numéro, nom ou variante" TextChanged="SearchText_TextChanged" /></Grid>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource ModernPanel}" Padding="12">
            <Grid><ListBox x:Name="PackagesList" SelectionMode="Single" MouseDoubleClick="PackagesList_MouseDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Margin" Value="0,0,0,8" /><Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Card" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#26384D" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="Background" Value="#264B75" /><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" /><Setter TargetName="Card" Property="BorderThickness" Value="2" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="130" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions><Border Width="56" Height="56" CornerRadius="28" Background="#1D3E65"><TextBlock Text="{Binding Counter, Mode=OneWay, StringFormat={}{0:000}}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#9BC9FF" FontSize="16" FontWeight="Bold" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding ManifestLabel, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,0" /></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="VARIANTE" Style="{StaticResource EyebrowText}" /><TextBlock Text="{Binding VariantLabel, Mode=OneWay}" Margin="0,5,0,0" /></StackPanel><StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock Text="CONTENU" Style="{StaticResource EyebrowText}" /><TextBlock Margin="0,5,0,0"><Run Text="{Binding ComponentCount, Mode=OneWay}" /><Run Text=" composants" /></TextBlock><TextBlock Foreground="{StaticResource MutedBrush}" FontSize="10"><Run Text="{Binding FileCount, Mode=OneWay}" /><Run Text=" fichiers" /></TextBlock></StackPanel><StackPanel Grid.Column="4" VerticalAlignment="Center"><TextBlock Text="MODIFIÉ" Style="{StaticResource EyebrowText}" /><TextBlock Text="{Binding ModifiedLabel, Mode=OneWay}" Margin="0,5,0,0" /></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox><TextBlock x:Name="EmptyText" Text="Aucun package conforme trouvé dans ce dossier." Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="16" /></Grid>
        </Border>
        <Grid Grid.Row="4"><TextBlock x:Name="WarningsText" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="↗ Ouvrir le dossier" Click="OpenFolderButton_Click" /><Button Content="Mettre en corbeille" Background="#512A33" BorderBrush="#7D4350" Margin="8,0,0,0" Click="TrashButton_Click" /><Button Content="Modifier le package  →" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="ModifyButton_Click" /></StackPanel></Grid>
    </Grid>
</Window>
