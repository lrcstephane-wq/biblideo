<UserControl x:Class="Biblideo.App.Views.AtlasLicensesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             xmlns:controls="clr-namespace:Biblideo.App.Controls"
             Loaded="Refresh_Click">
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="../Controls/AtlasCalendar.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <DataTemplate x:Key="ClientNameTemplate">
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="AtlasCompaniesListPanel">
            <VirtualizingStackPanel/>
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="AtlasCompaniesCardPanel">
            <controls:VirtualizingWrapPanel TargetItemWidth="315" ItemHeight="153" Spacing="10"/>
        </ItemsPanelTemplate>
        <Style x:Key="AtlasCompanyListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AtlasCompanyCardItem" TargetType="ListBoxItem" BasedOn="{StaticResource AtlasCompanyListItem}">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Height" Value="153"/>
        </Style>
        <DataTemplate x:Key="AtlasCompanyIdentity">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="38" Height="38" HorizontalAlignment="Left" CornerRadius="19" Background="#21466F">
                    <TextBlock Text="{Binding Initials}" Foreground="#A9D1FF" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                    <TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="AtlasCompanyMetrics">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="ÉTAT" Style="{StaticResource EyebrowText}"/>
                    <TextBlock Text="{Binding Status}" Foreground="{Binding StateColor}" FontWeight="SemiBold" Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="PREMIÈRE ÉCHÉANCE" Style="{StaticResource EyebrowText}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding ExpiryLabel}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <Style x:Key="AtlasCompanyTile" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="15,12"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Background" Value="#243B55"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="AtlasCompanyListTemplate">
            <Border Style="{StaticResource AtlasCompanyTile}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="4" Background="{Binding StateColor}" CornerRadius="2" HorizontalAlignment="Left" Margin="-9,0,0,0"/>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AtlasCompanyIdentity}" Margin="1,0,10,0"/>
                    <ContentControl Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource AtlasCompanyMetrics}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="AtlasCompanyCardTemplate">
            <Border Style="{StaticResource AtlasCompanyTile}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Grid.RowSpan="2" Width="4" Background="{Binding StateColor}" CornerRadius="2" HorizontalAlignment="Left" Margin="-9,0,0,0"/>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AtlasCompanyIdentity}" Margin="1,0,0,0"/>
                    <Border Grid.Row="1" Background="{StaticResource FieldBrush}" CornerRadius="7" Padding="10"
                            Margin="1,11,0,0" VerticalAlignment="Center">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AtlasCompanyMetrics}"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
        <Style x:Key="ValidLicenseLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Expirée">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <BooleanToVisibilityConverter x:Key="ShowWhenTrue"/>
        <Style TargetType="primitives:DatePickerTextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="primitives:DatePickerTextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="6,4">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="5" Margin="0,0,6,5" Padding="14,8">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Emplacement du registre" Click="Configure_Click" Margin="0,0,8,0"/>
                <Button Content="Actualiser" Click="Refresh_Click"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Text="Lecture du registre Atlas…" TextWrapping="Wrap" Margin="0,0,12,0"/>
        </DockPanel>
        <TabControl Grid.Row="1" x:Name="LicenseTabs" Background="{StaticResource BackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}" Padding="0">
            <TabItem x:Name="GeneratorTab" Header="Générateurs Idéo">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16">
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Licence pour un poste client" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="Choisis la fiche client, colle l’identifiant Atlas et indique la date de fin, incluse."
                                           TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                                <WrapPanel x:Name="Fields" IsEnabled="False" Margin="0,12,0,2">
                                    <StackPanel Margin="0,0,12,8" Width="200">
                                        <TextBlock Text="Client"/>
                                        <ComboBox x:Name="Customers" ItemTemplate="{StaticResource ClientNameTemplate}" TextSearch.TextPath="Name" AutomationProperties.Name="Client"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,8" Width="220">
                                        <TextBlock Text="Identifiant du poste Atlas"/>
                                        <TextBox x:Name="DeviceInput" MaxLength="40" AutomationProperties.Name="Identifiant du poste Atlas"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,8" Width="132">
                                        <TextBlock Text="Fin de validité"/>
                                        <DatePicker x:Name="ExpiryInput" CalendarStyle="{StaticResource AtlasCalendar}" SelectedDateFormat="Short" Foreground="{StaticResource TextBrush}" AutomationProperties.Name="Fin de validité"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,8" Width="112">
                                        <TextBlock Text="Offre"/>
                                        <ComboBox x:Name="OfferInput" SelectedIndex="0" AutomationProperties.Name="Offre Atlas">
                                            <ComboBoxItem Content="Standard"/><ComboBoxItem Content="Créateur"/>
                                        </ComboBox>
                                    </StackPanel>
                                </WrapPanel>
                                <WrapPanel Margin="0,4,0,10">
                                    <TextBlock x:Name="KeyStatusText" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Button Content="Choisir la clé Idéo" Click="BrowseKey_Click"/>
                                </WrapPanel>
                                <WrapPanel x:Name="Actions" IsEnabled="False">
                                    <Button x:Name="CreateButton" Content="Générer une licence" Tag="create" Click="Sign_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,6,6"/>
                                    <Button Content="Renouveler" Tag="renew" Click="Sign_Click" Margin="0,0,6,6" x:Name="RenewButton"/>
                                    <Button Content="Changer de poste" Tag="transfer" Click="Sign_Click" Margin="0,0,6,6" x:Name="TransferButton"/>
                                    <Button Content="Passer en Créateur" Tag="upgrade" Click="Sign_Click" Margin="0,0,6,6" x:Name="UpgradeButton"/>
                                    <Button x:Name="LinkButton" Content="Rattacher à une fiche" Tag="link" Click="Sign_Click" Margin="0,0,6,6"/>
                                    <Button Content="Exporter le fichier" Click="Export_Click" Margin="0,0,6,6" x:Name="ExportButton"/>
                                </WrapPanel>
                                <TextBox x:Name="GeneratedLicenseText" IsReadOnly="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" Height="66" Margin="0,4,0,8" AutomationProperties.Name="Code de licence Atlas"/>
                                <Button x:Name="CopyButton" Content="Copier le code" Click="CopyCode_Click" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Accès Administrateur Idéo à usage unique" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="Colle la demande affichée par Atlas sur le poste client. La réponse est valable cinq minutes."
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,12"/>
                                <TextBlock Text="Opérateur Idéo"/>
                                <TextBox x:Name="OperatorInput" MaxLength="120" Margin="0,4,0,8" AutomationProperties.Name="Opérateur Idéo"/>
                                <TextBlock Text="Demande du poste client"/>
                                <TextBox x:Name="AdminRequestInput" MaxLength="8192" AcceptsReturn="True" Height="54"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,4,0,8" AutomationProperties.Name="Demande du poste client"/>
                                <Button Content="Générer la réponse Idéo" Click="GenerateAdminResponse_Click"
                                        HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}"/>
                                <TextBox x:Name="AdminResponseText" IsReadOnly="True" TextWrapping="Wrap" Height="66"
                                         VerticalScrollBarVisibility="Auto" Margin="0,8,0,8" AutomationProperties.Name="Réponse Administrateur Idéo"/>
                                <Button x:Name="CopyAdminButton" Content="Copier la réponse" Click="CopyAdminResponse_Click"
                                        HorizontalAlignment="Left" IsEnabled="False"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Suivi des clients">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource ModernPanel}" Padding="10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="184"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid>
                                <TextBox x:Name="AtlasSearch" TextChanged="TrackingSearch_Changed" Padding="35,8,10,8"
                                         AutomationProperties.Name="Rechercher un client ou un poste Atlas" ToolTip="Rechercher un client ou un poste Atlas"/>
                                <TextBlock Text="⌕" Foreground="{StaticResource MutedBrush}" FontSize="18" Margin="11,0,0,0"
                                           VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                            </Grid>
                            <ComboBox x:Name="AtlasStatusFilter" Grid.Column="1" Margin="10,0,0,0" SelectedIndex="0"
                                      SelectionChanged="TrackingSearch_Changed" AutomationProperties.Name="État des licences">
                                <ComboBoxItem Content="Tous les états"/>
                                <ComboBoxItem Content="Avec licence valide" Tag="valid"/>
                                <ComboBoxItem Content="Avec licence expirée" Tag="expired"/>
                                <ComboBoxItem Content="Fiche à rattacher" Tag="unlinked"/>
                            </ComboBox>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                                <Button x:Name="AtlasListButton" Content="☷ Liste" Click="TrackingList_Click"/>
                                <Button x:Name="AtlasCardsButton" Content="▦ Cartes" Click="TrackingCards_Click" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource ModernPanel}" Padding="8">
                            <Grid>
                                <ListBox x:Name="RegistryCards" Background="Transparent" BorderThickness="0"
                                         SelectionChanged="RegistryCards_SelectionChanged"
                                         ItemContainerStyle="{StaticResource AtlasCompanyListItem}"
                                         ItemTemplate="{StaticResource AtlasCompanyListTemplate}"
                                         ItemsPanel="{StaticResource AtlasCompaniesListPanel}"
                                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                         VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                                <TextBlock x:Name="RegistryEmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedBrush}" Margin="12" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>
                        <Border x:Name="AtlasCompanyDetails" Grid.Column="1" Width="405" Margin="10,0,0,0"
                                Style="{StaticResource ModernPanel}" Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Border Background="{StaticResource HeaderBrush}" CornerRadius="11,11,0,0" Padding="14,10">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="×" Click="CloseAtlasCompany_Click" Padding="9,4"
                                                VerticalAlignment="Center" AutomationProperties.Name="Fermer la fiche Atlas"/>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="SUIVI CLIENT ATLAS" Style="{StaticResource EyebrowText}"/>
                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                                            <TextBlock Text="Fiche client à rattacher" Foreground="{StaticResource WarningBrush}" Margin="0,4,0,0"
                                                       Visibility="{Binding NeedsLink, Converter={StaticResource ShowWhenTrue}}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <ListBox Grid.Row="1" ItemsSource="{Binding Licenses}" Background="Transparent" BorderThickness="0"
                                         Margin="8,9,8,5" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
                                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource AtlasCompanyListItem}">
                                            <Setter Property="Focusable" Value="False"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="8" Padding="10">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DeviceId}" FontFamily="Consolas" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <WrapPanel Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding Offer, StringFormat='Licence {0}'}" Margin="0,0,10,0"/>
                                                        <TextBlock Text="{Binding ValidUntil, StringFormat='Échéance {0:dd/MM/yyyy}'}"
                                                                   Foreground="{StaticResource MutedBrush}" Margin="0,0,10,0"/>
                                                        <TextBlock Text="{Binding Status}" Style="{StaticResource ValidLicenseLabel}"/>
                                                    </WrapPanel>
                                                    <WrapPanel Margin="0,8,0,0">
                                                        <Button Content="Gérer" Tag="{Binding}" Click="OpenGenerator_Click" Padding="8,4" Margin="0,0,5,4"/>
                                                        <Button Content="Historique" Tag="{Binding}" Click="History_Click" Padding="8,4" Margin="0,0,5,4"/>
                                                        <Button Content="Supprimer la licence" Tag="{Binding}" Click="RemoveLicense_Click" Padding="8,4" Margin="0,0,0,4"
                                                                Foreground="{StaticResource WarningBrush}"
                                                                IsEnabled="{Binding DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Grid.Row="2" Content="Supprimer toutes les licences" Click="RemoveCompanyLicenses_Click" Tag="{Binding}"
                                        Margin="10,3,10,10" HorizontalAlignment="Right"
                                        Foreground="{StaticResource WarningBrush}" IsEnabled="{Binding CanDelete}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
