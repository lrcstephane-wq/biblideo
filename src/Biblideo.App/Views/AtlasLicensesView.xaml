<UserControl x:Class="Biblideo.App.Views.AtlasLicensesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             Loaded="Refresh_Click">
    <UserControl.Resources>
        <Style x:Key="AtlasColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>
        <Style TargetType="primitives:DatePickerTextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="primitives:DatePickerTextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="6,4">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="5" Margin="0,0,6,5" Padding="14,8">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Emplacement du registre" Click="Configure_Click" Margin="0,0,8,0"/>
                <Button Content="Actualiser" Click="Refresh_Click"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Text="Lecture du registre Atlas…" TextWrapping="Wrap" Margin="0,0,12,0"/>
        </DockPanel>
        <TabControl Grid.Row="1" x:Name="LicenseTabs" Background="{StaticResource BackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}" Padding="0">
            <TabItem x:Name="GeneratorTab" Header="Générateurs Idéo">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16">
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Licence pour un poste client" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="Choisis la fiche client, colle l’identifiant Atlas et indique la date de fin, incluse."
                                           TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                                <WrapPanel x:Name="Fields" IsEnabled="False" Margin="0,12,0,2">
                                    <StackPanel Margin="0,0,12,8" Width="200">
                                        <TextBlock Text="Client"/>
                                        <ComboBox x:Name="Customers" DisplayMemberPath="Name" AutomationProperties.Name="Client"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,8" Width="220">
                                        <TextBlock Text="Identifiant du poste Atlas"/>
                                        <TextBox x:Name="DeviceInput" MaxLength="40" AutomationProperties.Name="Identifiant du poste Atlas"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,8" Width="132">
                                        <TextBlock Text="Fin de validité"/>
                                        <DatePicker x:Name="ExpiryInput" SelectedDateFormat="Short" Foreground="{StaticResource TextBrush}" AutomationProperties.Name="Fin de validité"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,8" Width="112">
                                        <TextBlock Text="Offre"/>
                                        <ComboBox x:Name="OfferInput" SelectedIndex="0" AutomationProperties.Name="Offre Atlas">
                                            <ComboBoxItem Content="Standard"/><ComboBoxItem Content="Créateur"/>
                                        </ComboBox>
                                    </StackPanel>
                                </WrapPanel>
                                <WrapPanel Margin="0,4,0,10">
                                    <TextBlock x:Name="KeyStatusText" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Button Content="Choisir la clé Idéo" Click="BrowseKey_Click"/>
                                </WrapPanel>
                                <WrapPanel x:Name="Actions" IsEnabled="False">
                                    <Button x:Name="CreateButton" Content="Générer une licence" Tag="create" Click="Sign_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,6,6"/>
                                    <Button Content="Renouveler" Tag="renew" Click="Sign_Click" Margin="0,0,6,6" x:Name="RenewButton"/>
                                    <Button Content="Changer de poste" Tag="transfer" Click="Sign_Click" Margin="0,0,6,6" x:Name="TransferButton"/>
                                    <Button Content="Passer en Créateur" Tag="upgrade" Click="Sign_Click" Margin="0,0,6,6" x:Name="UpgradeButton"/>
                                    <Button x:Name="LinkButton" Content="Rattacher à une fiche" Tag="link" Click="Sign_Click" Margin="0,0,6,6"/>
                                    <Button Content="Exporter le fichier" Click="Export_Click" Margin="0,0,6,6" x:Name="ExportButton"/>
                                </WrapPanel>
                                <TextBox x:Name="GeneratedLicenseText" IsReadOnly="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" Height="66" Margin="0,4,0,8" AutomationProperties.Name="Code de licence Atlas"/>
                                <Button x:Name="CopyButton" Content="Copier le code" Click="CopyCode_Click" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Accès Administrateur Idéo à usage unique" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="Colle la demande affichée par Atlas sur le poste client. La réponse est valable cinq minutes."
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,12"/>
                                <TextBlock Text="Opérateur Idéo"/>
                                <TextBox x:Name="OperatorInput" MaxLength="120" Margin="0,4,0,8" AutomationProperties.Name="Opérateur Idéo"/>
                                <TextBlock Text="Demande du poste client"/>
                                <TextBox x:Name="AdminRequestInput" MaxLength="8192" AcceptsReturn="True" Height="54"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,4,0,8" AutomationProperties.Name="Demande du poste client"/>
                                <Button Content="Générer la réponse Idéo" Click="GenerateAdminResponse_Click"
                                        HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}"/>
                                <TextBox x:Name="AdminResponseText" IsReadOnly="True" TextWrapping="Wrap" Height="66"
                                         VerticalScrollBarVisibility="Auto" Margin="0,8,0,8" AutomationProperties.Name="Réponse Administrateur Idéo"/>
                                <Button x:Name="CopyAdminButton" Content="Copier la réponse" Click="CopyAdminResponse_Click"
                                        HorizontalAlignment="Left" IsEnabled="False"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Registre">
                <Grid Margin="16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,10">
                        <Button x:Name="OpenGeneratorButton" Content="Ouvrir la licence dans le générateur" Click="OpenGenerator_Click" Margin="0,0,8,0"/>
                        <Button x:Name="HistoryButton" Content="Historique" Click="History_Click"/>
                    </WrapPanel>
                    <DataGrid Grid.Row="1" x:Name="Licenses" ColumnHeaderStyle="{StaticResource AtlasColumnHeader}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                              RowBackground="{StaticResource SurfaceBrush}" AlternatingRowBackground="{StaticResource BackgroundBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Client" Width="*" Binding="{Binding ClientLabel}"/>
                            <DataGridTextColumn Header="Poste Atlas" Width="220" Binding="{Binding DeviceId}"/>
                            <DataGridTextColumn Header="Offre" Width="100" Binding="{Binding Offer}"/>
                            <DataGridTextColumn Header="Échéance" Width="115" Binding="{Binding ValidUntil, StringFormat=dd/MM/yyyy}"/>
                            <DataGridTextColumn Header="État" Width="95" Binding="{Binding Status}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
