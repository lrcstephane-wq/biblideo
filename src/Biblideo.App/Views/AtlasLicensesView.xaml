<UserControl x:Class="Biblideo.App.Views.AtlasLicensesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="Refresh_Click">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Content="Actualiser" Click="Refresh_Click"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Text="Connexion au registre des licences Atlas…" TextWrapping="Wrap"/>
        </DockPanel>
        <DataGrid x:Name="Licenses" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                  RowBackground="{StaticResource SurfaceBrush}" AlternatingRowBackground="{StaticResource BackgroundBrush}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Client" Width="*" Binding="{Binding ClientLabel}"/>
                <DataGridTextColumn Header="Poste Atlas" Width="220" Binding="{Binding DeviceId}"/>
                <DataGridTextColumn Header="Offre" Width="100" Binding="{Binding Offer}"/>
                <DataGridTextColumn Header="Échéance" Width="115" Binding="{Binding ValidUntil, StringFormat=dd/MM/yyyy}"/>
                <DataGridTextColumn Header="État" Width="95" Binding="{Binding Status}"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <WrapPanel x:Name="Fields" IsEnabled="False">
                <StackPanel Margin="0,0,12,8" Width="200">
                    <TextBlock Text="Client"/>
                    <ComboBox x:Name="Customers" DisplayMemberPath="Name" AutomationProperties.Name="Client"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,8" Width="220">
                    <TextBlock Text="Identifiant du poste Atlas"/>
                    <TextBox x:Name="DeviceInput" MaxLength="40" AutomationProperties.Name="Identifiant du poste Atlas"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,8" Width="132">
                    <TextBlock Text="Fin de validité"/>
                    <DatePicker x:Name="ExpiryInput" SelectedDateFormat="Short" AutomationProperties.Name="Fin de validité"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,8" Width="112">
                    <TextBlock Text="Offre"/>
                    <ComboBox x:Name="OfferInput" SelectedIndex="0" AutomationProperties.Name="Offre Atlas">
                        <ComboBoxItem Content="Standard"/><ComboBoxItem Content="Créateur"/>
                    </ComboBox>
                </StackPanel>
            </WrapPanel>
            <WrapPanel Margin="0,0,0,8" IsEnabled="{Binding IsEnabled, ElementName=Fields}">
                <TextBlock x:Name="KeyStatusText" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button Content="Choisir la clé Idéo" Click="BrowseKey_Click"/>
            </WrapPanel>
            <WrapPanel x:Name="Actions" IsEnabled="False">
                <Button x:Name="CreateButton" Content="Générer une licence" Tag="create" Click="Sign_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,6,6"/>
                <Button Content="Renouveler" Tag="renew" Click="Sign_Click" Margin="0,0,6,6" x:Name="RenewButton"/>
                <Button Content="Changer de poste" Tag="transfer" Click="Sign_Click" Margin="0,0,6,6" x:Name="TransferButton"/>
                <Button Content="Passer en Créateur" Tag="upgrade" Click="Sign_Click" Margin="0,0,6,6" x:Name="UpgradeButton"/>
                <Button x:Name="LinkButton" Content="Rattacher à une fiche" Tag="link" Click="Sign_Click" Margin="0,0,6,6"/>
                <Button x:Name="CopyButton" Content="Copier le code" Click="CopyCode_Click" Margin="0,0,6,6"/>
                <Button Content="Historique" Click="History_Click" Margin="0,0,6,6" x:Name="HistoryButton"/>
                <Button Content="Exporter le fichier" Click="Export_Click" Margin="0,0,6,6" x:Name="ExportButton"/>
            </WrapPanel>
        </StackPanel>
    </Grid>
</UserControl>
