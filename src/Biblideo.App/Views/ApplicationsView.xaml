<UserControl x:Class="Biblideo.App.Views.ApplicationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ApplicationRow" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="20,17" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24" MaxWidth="960" HorizontalAlignment="Stretch">
            <Border Style="{StaticResource ApplicationRow}" Margin="0,0,0,12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <Button Content="Licences" Tag="Licenses" Click="OpenSection_Click" Margin="0,0,8,0" />
                        <Button Content="Ouvrir l’atelier" Tag="Product" Click="OpenSection_Click" Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Biblidéo" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="Abonnement par établissement, utilisateurs illimités."
                                   Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource ApplicationRow}">
                <StackPanel>
                    <TextBlock Text="Atlas" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock Text="Licences Standard et Créateur par poste."
                               Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
                    <Button Content="Ouvrir les licences Atlas" Tag="AtlasLicenses" Click="OpenSection_Click"
                                HorizontalAlignment="Left" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
