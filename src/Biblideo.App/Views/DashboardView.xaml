<UserControl x:Class="Biblideo.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="26,22,26,24">
            <Grid Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock x:Name="TodayText" FontSize="27" FontWeight="SemiBold"/>
                    <TextBlock x:Name="DailyPhraseText" Foreground="{StaticResource MutedBrush}" FontSize="13" FontStyle="Italic" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse x:Name="SystemDot" Width="10" Height="10" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="SystemStatusText" Text="Contrôle des accès…" Foreground="{StaticResource MutedBrush}"/>
                    <Button Content="↻ Actualiser" Click="Refresh_Click" Margin="14,0,0,0"/>
                </StackPanel>
            </Grid>

            <Border Background="#102B4B" BorderBrush="#245D93" BorderThickness="1" CornerRadius="15" Padding="22,18" Margin="0,0,0,14">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,18,0"><TextBlock Text="COCKPIT BIBLIDÉO" Style="{StaticResource EyebrowText}"/><TextBlock Text="La post-production, sans angle mort" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,4"/><TextBlock x:Name="CockpitSummaryText" Text="Chargement de la situation…" Foreground="#AEC5DF" TextWrapping="Wrap"/></StackPanel>
                    <Button Grid.Column="1" Tag="Product" Click="Navigate_Click" Margin="0,0,9,0" Padding="14" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="PACKAGES PRODUIT" Style="{StaticResource EyebrowText}"/><TextBlock x:Name="ProductCountText" Text="—" FontSize="29" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="à préparer" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel></Button>
                    <Button Grid.Column="2" Tag="Clients" Click="Navigate_Click" Margin="0,0,9,0" Padding="14" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="CLIENTS SOUS MAJ" Foreground="{StaticResource SuccessBrush}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="SubscribedCountText" Text="—" FontSize="29" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock x:Name="ClientCountCaption" Text="clients suivis" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel></Button>
                    <Button Grid.Column="3" Tag="Licenses" Click="Navigate_Click" Margin="0,0,9,0" Padding="14" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="LICENCES À TRIER" Foreground="#C68BE3" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="InboxCountText" Text="—" FontSize="29" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="dans la boîte" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel></Button>
                    <Button Grid.Column="4" Tag="Licenses" Click="Navigate_Click" Padding="14" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="ÉCHÉANCES" Foreground="{StaticResource WarningBrush}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="RenewCountText" Text="—" FontSize="29" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="à traiter" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel></Button>
                </Grid>
            </Border>

            <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource ModernPanel}" Padding="18" Margin="0,0,12,0">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid><StackPanel><TextBlock Text="À TRAITER" Style="{StaticResource EyebrowText}"/><TextBlock Text="Les sujets qui méritent ton attention" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel><TextBlock x:Name="PriorityCountText" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/></Grid>
                        <Grid Grid.Row="1" Margin="0,14,0,0"><TextBlock x:Name="PriorityEmptyText" Text="Rien d’urgent. C’est suspect, mais agréable." Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            <ItemsControl x:Name="PriorityList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Margin="0,0,0,8" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="{Binding Accent}" CornerRadius="4" Margin="0,1,10,1"/><StackPanel Grid.Column="1" Margin="10,0,12,0"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="2" Content="{Binding ActionLabel}" Tag="{Binding Destination}" Click="Navigate_Click" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource ModernPanel}" Padding="18">
                    <StackPanel><TextBlock Text="ACCÈS DU POSTE" Style="{StaticResource EyebrowText}"/><TextBlock Text="Les fondations avant de lancer les machines" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,14"/>
                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,8"><Grid><TextBlock Text="Racine clients"/><TextBlock x:Name="ClientsAccessText" Text="Contrôle…" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/></Grid></Border>
                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,8"><Grid><TextBlock Text="Packages produit"/><TextBlock x:Name="PackagesAccessText" Text="Contrôle…" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/></Grid></Border>
                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,8"><Grid><TextBlock Text="Boîte licences"/><TextBlock x:Name="LicensesAccessText" Text="Contrôle…" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/></Grid></Border>
                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="12"><Grid><TextBlock Text="Configuration partagée"/><TextBlock x:Name="ConfigAccessText" Text="Contrôle…" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/></Grid></Border>
                        <Button Content="⚙ Vérifier les paramètres" Tag="Settings" Click="Navigate_Click" Margin="0,13,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource ModernPanel}" Padding="18" Margin="0,0,0,14">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel><TextBlock Text="FLUX DE PRODUCTION" Style="{StaticResource EyebrowText}"/><TextBlock Text="Du composant approuvé jusqu’au client" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                    <Grid Grid.Row="1" Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button Tag="Product" Click="Navigate_Click" Padding="16" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="01" Foreground="{StaticResource AccentBrush}" FontSize="20" FontWeight="Bold"/><TextBlock Text="Package produit" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="Composer et contrôler" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel></Button><TextBlock Grid.Column="1" Text="→" Foreground="{StaticResource AccentBrush}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Tag="Monthly" Click="Navigate_Click" Padding="16" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="02" Foreground="{StaticResource AccentBrush}" FontSize="20" FontWeight="Bold"/><TextBlock Text="Pack mensuel" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="Assembler SC ou EP" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel></Button><TextBlock Grid.Column="3" Text="→" Foreground="{StaticResource AccentBrush}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button Grid.Column="4" Tag="Deployment" Click="Navigate_Click" Padding="16" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="03" Foreground="{StaticResource AccentBrush}" FontSize="20" FontWeight="Bold"/><TextBlock Text="Déploiement" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="Tester puis distribuer" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel></Button><TextBlock Grid.Column="5" Text="→" Foreground="{StaticResource AccentBrush}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button Grid.Column="6" Tag="Clients" Click="Navigate_Click" Padding="16" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="04" Foreground="{StaticResource SuccessBrush}" FontSize="20" FontWeight="Bold"/><TextBlock Text="Clients" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="Contrôler et tracer" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel></Button>
                    </Grid>
                </Grid>
            </Border>

            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="0.7*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource ModernPanel}" Padding="18" Margin="0,0,12,0"><StackPanel><TextBlock Text="ACTIVITÉ RÉCENTE" Style="{StaticResource EyebrowText}"/><TextBlock Text="Les dernières opérations tracées" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,13"/><ItemsControl x:Name="ActivityList"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding When}" Foreground="{StaticResource SubtleBrush}" FontFamily="Consolas"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock x:Name="ActivityEmptyText" Text="Pas encore d’activité enregistrée." Foreground="{StaticResource MutedBrush}" Visibility="Collapsed"/></StackPanel></Border>
                <Border Grid.Column="1" Background="#102B4B" BorderBrush="#245D93" BorderThickness="1" CornerRadius="12" Padding="18"><StackPanel><TextBlock Text="RACCOURCIS" Style="{StaticResource EyebrowText}"/><TextBlock Text="Atteindre le bon atelier" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,13"/><Button Content="＋ Nouveau package" Tag="Product" Click="Navigate_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8"/><Button Content="♙ Gérer les clients" Tag="Clients" Click="Navigate_Click" Margin="0,0,0,8"/><Button Content="◇ Distribuer les licences" Tag="Licenses" Click="Navigate_Click"/></StackPanel></Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
