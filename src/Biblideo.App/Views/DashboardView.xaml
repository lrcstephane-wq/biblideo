<UserControl x:Class="Biblideo.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32">
            <Border Background="#10284A" BorderBrush="#1C7892" BorderThickness="1" CornerRadius="16" Padding="26">
                <StackPanel>
                    <TextBlock Text="POST-PRODUCTION BIBLIDÉO" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="Bold" />
                    <TextBlock Text="Un flux contrôlé, du composant au client" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,8" />
                    <TextBlock Text="Cette version analyse et simule les opérations sans modifier les dossiers métier." Foreground="{StaticResource MutedBrush}" FontSize="15" />
                </StackPanel>
            </Border>
            <UniformGrid Columns="3" Margin="0,22,0,0">
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="20" Margin="0,0,12,12">
                    <StackPanel><TextBlock Text="1" Foreground="{StaticResource AccentBrush}" FontSize="24" FontWeight="Bold"/><TextBlock Text="Constituer un package produit" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,4"/><TextBlock Text="Sélection visuelle et rapport simulé." Foreground="{StaticResource MutedBrush}"/></StackPanel>
                </Border>
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="20" Margin="0,0,12,12">
                    <StackPanel><TextBlock Text="2" Foreground="{StaticResource AccentBrush}" FontSize="24" FontWeight="Bold"/><TextBlock Text="Créer le pack mensuel" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,4"/><TextBlock Text="SFX 7-Zip par package produit." Foreground="{StaticResource MutedBrush}"/></StackPanel>
                </Border>
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="20" Margin="0,0,0,12">
                    <StackPanel><TextBlock Text="3" Foreground="{StaticResource AccentBrush}" FontSize="24" FontWeight="Bold"/><TextBlock Text="Déployer et contrôler" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,4"/><TextBlock Text="Variante client, test et traçabilité." Foreground="{StaticResource MutedBrush}"/></StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
