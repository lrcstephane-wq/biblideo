<UserControl x:Class="Biblideo.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32" MaxWidth="1100" HorizontalAlignment="Left">
            <Button x:Name="NexusRegistrySettingsButton" Content="Emplacement du registre Nexus"
                    HorizontalAlignment="Left" Margin="0,0,0,16" Click="OpenNexusRegistrySettings_Click"/>
            <Border Background="#10284A" BorderBrush="#1C7892" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="CHEMINS PARAMÉTRABLES" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="Bold" />
                    <TextBlock Text="Aucun chemin métier n’est codé en dur" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,4" />
                    <TextBlock Text="Les règles métier sont partagées sur le réseau. Les chemins ci-dessous sont mémorisés pour ce poste : Nextcloud ici, lecteur NAS au bureau, sans partie de cache-cache avec Windows." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="22">
                <Grid x:Name="SettingsGrid">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Configuration partagée" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/><TextBox x:Name="SharedSettingsText" Grid.Column="1" Margin="8"/><Button Grid.Column="2" Content="Choisir" Margin="4" Click="BrowseSharedSettings_Click"/>
                    <TextBlock Grid.Row="1" Text="Source bibliothèque SC" VerticalAlignment="Center"/><TextBox x:Name="SourceScText" Grid.Row="1" Grid.Column="1" Margin="8"/><Button Grid.Row="1" Grid.Column="2" Content="Parcourir" Margin="4" Tag="SourceScText" Click="BrowseFolder_Click"/>
                    <TextBlock Grid.Row="2" Text="Source bibliothèque EP" VerticalAlignment="Center"/><TextBox x:Name="SourceEpText" Grid.Row="2" Grid.Column="1" Margin="8"/><Button Grid.Row="2" Grid.Column="2" Content="Parcourir" Margin="4" Tag="SourceEpText" Click="BrowseFolder_Click"/>
                    <TextBlock Grid.Row="3" Text="Racine clients" VerticalAlignment="Center"/><TextBox x:Name="ClientsRootText" Grid.Row="3" Grid.Column="1" Margin="8"/><Button Grid.Row="3" Grid.Column="2" Content="Parcourir" Margin="4" Tag="ClientsRootText" Click="BrowseFolder_Click"/>
                    <TextBlock Grid.Row="4" Text="Racine Idéo Solutions" VerticalAlignment="Center"/><TextBox x:Name="IdeoRootText" Grid.Row="4" Grid.Column="1" Margin="8"/><Button Grid.Row="4" Grid.Column="2" Content="Parcourir" Margin="4" Tag="IdeoRootText" Click="BrowseFolder_Click"/>
                    <TextBlock Grid.Row="5" Text="Packages produit à déployer" VerticalAlignment="Center"/><TextBox x:Name="ProductStagingText" Grid.Row="5" Grid.Column="1" Margin="8"/><Button Grid.Row="5" Grid.Column="2" Content="Parcourir" Margin="4" Tag="ProductStagingText" Click="BrowseFolder_Click"/>
                    <TextBlock Grid.Row="6" Text="Modèles et archives produit" VerticalAlignment="Center"/><TextBox x:Name="ProductArchivesText" Grid.Row="6" Grid.Column="1" Margin="8"/><Button Grid.Row="6" Grid.Column="2" Content="Parcourir" Margin="4" Tag="ProductArchivesText" Click="BrowseFolder_Click"/>
                    <TextBlock Grid.Row="7" Text="Rapports" VerticalAlignment="Center"/><TextBox x:Name="ReportsText" Grid.Row="7" Grid.Column="1" Margin="8"/><Button Grid.Row="7" Grid.Column="2" Content="Parcourir" Margin="4" Tag="ReportsText" Click="BrowseFolder_Click"/>
                    <TextBlock Grid.Row="8" Text="Corbeille des packages" VerticalAlignment="Center"/><TextBox x:Name="ProductTrashText" Grid.Row="8" Grid.Column="1" Margin="8"/><Button Grid.Row="8" Grid.Column="2" Content="Parcourir" Margin="4" Tag="ProductTrashText" Click="BrowseFolder_Click"/>
                    <TextBlock Grid.Row="9" Text="7-Zip — 7z.exe" VerticalAlignment="Center"/><TextBox x:Name="SevenZipText" Grid.Row="9" Grid.Column="1" Margin="8"/><Button Grid.Row="9" Grid.Column="2" Content="Parcourir" Margin="4" Click="BrowseExecutable_Click"/>
                </Grid>
            </Border>
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="22" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="GESTION DES CLIENTS" Style="{StaticResource EyebrowText}" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="Archives clients" VerticalAlignment="Center"/><TextBox x:Name="ClientArchiveText" Grid.Column="1" Margin="8"/><Button Grid.Column="2" Content="Parcourir" Margin="4" Tag="ClientArchiveText" Click="BrowseFolder_Click"/>
                        <TextBlock Grid.Row="1" Text="Registre clients partagé" VerticalAlignment="Center"/><TextBox x:Name="ClientRegistryText" Grid.Row="1" Grid.Column="1" Margin="8"/><Button Grid.Row="1" Grid.Column="2" Content="Choisir" Margin="4" Tag="ClientRegistryText|clients.json" Click="BrowseDataFile_Click"/>
                        <TextBlock Grid.Row="2" Text="Historique partagé" VerticalAlignment="Center"/><TextBox x:Name="ClientHistoryText" Grid.Row="2" Grid.Column="1" Margin="8"/><Button Grid.Row="2" Grid.Column="2" Content="Choisir" Margin="4" Tag="ClientHistoryText|clients-history.jsonl" Click="BrowseDataFile_Click"/>
                        <TextBlock Grid.Row="3" Text="Marqueur abonnement MAJ" VerticalAlignment="Center"/><TextBox x:Name="ClientMarkerText" Grid.Row="3" Grid.Column="1" Margin="8" MaxLength="8"/><TextBlock Grid.Row="3" Grid.Column="2" Text="Défaut : _" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Row="4" Text="Sous-dossiers client" VerticalAlignment="Center"/><TextBox x:Name="ClientFoldersText" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="8" ToolTip="Séparer les dossiers par un point-virgule"/>
                        <TextBlock Grid.Row="5" Text="Dossiers racine ignorés" VerticalAlignment="Center"/><TextBox x:Name="ClientIgnoredFoldersText" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="8" ToolTip="Séparer les noms par un point-virgule"/>
                        <TextBlock Grid.Row="6" Text="Notifications Outlook" VerticalAlignment="Center"/><TextBox x:Name="ClientRecipientsText" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Margin="8" ToolTip="Séparer les adresses par un point-virgule"/>
                    </Grid>
                    <TextBlock Text="Le marqueur est un réglage avancé. Le modifier ne renomme pas automatiquement les dossiers existants : l’onglet Clients les signalera avant toute intervention." Foreground="{StaticResource WarningBrush}" FontSize="10" TextWrapping="Wrap" Margin="8,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="22" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="GESTION DES LICENCES" Style="{StaticResource EyebrowText}" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="Boîte d’arrivée des .msg" VerticalAlignment="Center"/><TextBox x:Name="LicenseInboxText" Grid.Column="1" Margin="8"/><Button Grid.Column="2" Content="Parcourir" Margin="4" Tag="LicenseInboxText" Click="BrowseFolder_Click"/>
                        <TextBlock Grid.Row="1" Text="Corbeille des .msg" VerticalAlignment="Center"/><TextBox x:Name="LicenseTrashText" Grid.Row="1" Grid.Column="1" Margin="8"/><Button Grid.Row="1" Grid.Column="2" Content="Parcourir" Margin="4" Tag="LicenseTrashText" Click="BrowseFolder_Click"/>
                        <TextBlock Grid.Row="2" Text="Index partagé" VerticalAlignment="Center"/><TextBox x:Name="LicenseIndexText" Grid.Row="2" Grid.Column="1" Margin="8"/><Button Grid.Row="2" Grid.Column="2" Content="Choisir" Margin="4" Tag="LicenseIndexText|licenses-index.json" Click="BrowseDataFile_Click"/>
                        <TextBlock Grid.Row="3" Text="Historique partagé" VerticalAlignment="Center"/><TextBox x:Name="LicenseHistoryText" Grid.Row="3" Grid.Column="1" Margin="8"/><Button Grid.Row="3" Grid.Column="2" Content="Choisir" Margin="4" Tag="LicenseHistoryText|licenses-history.jsonl" Click="BrowseDataFile_Click"/>
                        <TextBlock Grid.Row="4" Text="Alerte renouvellement" VerticalAlignment="Center"/><TextBox x:Name="LicenseWarningDaysText" Grid.Row="4" Grid.Column="1" Margin="8"/><TextBlock Grid.Row="4" Grid.Column="2" Text="jours" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Row="5" Text="TopSolid Web Planner" VerticalAlignment="Center"/><TextBox x:Name="LicensePlannerText" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="8"/>
                    </Grid>
                </StackPanel>
            </Border>
            <Grid Margin="0,16,0,0">
                <TextBlock x:Name="TestResultText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Tester les accès" Click="TestPathsButton_Click" Margin="0,0,10,0" />
                    <Button Content="Enregistrer" Style="{StaticResource PrimaryButton}" Click="SaveButton_Click" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
