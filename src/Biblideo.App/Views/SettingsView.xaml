<UserControl x:Class="Biblideo.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32" MaxWidth="1100" HorizontalAlignment="Left">
            <Border Background="#10284A" BorderBrush="#1C7892" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="CHEMINS PARAMÉTRABLES" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="Bold" />
                    <TextBlock Text="Aucun chemin métier n’est codé en dur" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,4" />
                    <TextBlock Text="La configuration métier est partagée sur le réseau. Une copie locale permet de continuer à consulter les réglages si le réseau est momentanément indisponible." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="22">
                <Grid x:Name="SettingsGrid">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Configuration partagée" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/><TextBox x:Name="SharedSettingsText" Grid.Column="1" Margin="8"/><Button Grid.Column="2" Content="Choisir" Margin="4" Click="BrowseSharedSettings_Click"/>
                    <TextBlock Grid.Row="1" Text="Source bibliothèque SC" VerticalAlignment="Center"/><TextBox x:Name="SourceScText" Grid.Row="1" Grid.Column="1" Margin="8"/><Button Grid.Row="1" Grid.Column="2" Content="Parcourir" Margin="4" Tag="SourceScText" Click="BrowseFolder_Click"/>
                    <TextBlock Grid.Row="2" Text="Source bibliothèque EP" VerticalAlignment="Center"/><TextBox x:Name="SourceEpText" Grid.Row="2" Grid.Column="1" Margin="8"/><Button Grid.Row="2" Grid.Column="2" Content="Parcourir" Margin="4" Tag="SourceEpText" Click="BrowseFolder_Click"/>
                    <TextBlock Grid.Row="3" Text="Racine clients" VerticalAlignment="Center"/><TextBox x:Name="ClientsRootText" Grid.Row="3" Grid.Column="1" Margin="8"/><Button Grid.Row="3" Grid.Column="2" Content="Parcourir" Margin="4" Tag="ClientsRootText" Click="BrowseFolder_Click"/>
                    <TextBlock Grid.Row="4" Text="Racine Idéo Solutions" VerticalAlignment="Center"/><TextBox x:Name="IdeoRootText" Grid.Row="4" Grid.Column="1" Margin="8"/><Button Grid.Row="4" Grid.Column="2" Content="Parcourir" Margin="4" Tag="IdeoRootText" Click="BrowseFolder_Click"/>
                    <TextBlock Grid.Row="5" Text="Packages produit à déployer" VerticalAlignment="Center"/><TextBox x:Name="ProductStagingText" Grid.Row="5" Grid.Column="1" Margin="8"/><Button Grid.Row="5" Grid.Column="2" Content="Parcourir" Margin="4" Tag="ProductStagingText" Click="BrowseFolder_Click"/>
                    <TextBlock Grid.Row="6" Text="Modèles et archives produit" VerticalAlignment="Center"/><TextBox x:Name="ProductArchivesText" Grid.Row="6" Grid.Column="1" Margin="8"/><Button Grid.Row="6" Grid.Column="2" Content="Parcourir" Margin="4" Tag="ProductArchivesText" Click="BrowseFolder_Click"/>
                    <TextBlock Grid.Row="7" Text="Rapports" VerticalAlignment="Center"/><TextBox x:Name="ReportsText" Grid.Row="7" Grid.Column="1" Margin="8"/><Button Grid.Row="7" Grid.Column="2" Content="Parcourir" Margin="4" Tag="ReportsText" Click="BrowseFolder_Click"/>
                    <TextBlock Grid.Row="8" Text="7-Zip — 7z.exe" VerticalAlignment="Center"/><TextBox x:Name="SevenZipText" Grid.Row="8" Grid.Column="1" Margin="8"/><Button Grid.Row="8" Grid.Column="2" Content="Parcourir" Margin="4" Click="BrowseExecutable_Click"/>
                </Grid>
            </Border>
            <Grid Margin="0,16,0,0">
                <TextBlock x:Name="TestResultText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Tester les accès" Click="TestPathsButton_Click" Margin="0,0,10,0" />
                    <Button Content="Enregistrer" Style="{StaticResource PrimaryButton}" Click="SaveButton_Click" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
