<UserControl x:Class="Biblideo.App.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32">
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="35" HorizontalAlignment="Center" VerticalAlignment="Center" Width="560">
            <StackPanel>
                <TextBlock Text="MODULE PRÉVU" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock x:Name="ModuleTitle" FontSize="26" FontWeight="SemiBold" Margin="0,10" HorizontalAlignment="Center" />
                <TextBlock Text="Le module est visible dans l’architecture de la V0. Son fonctionnement sera développé après validation du flux des packages produit." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
