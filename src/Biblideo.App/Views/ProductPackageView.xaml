<UserControl x:Class="Biblideo.App.Views.ProductPackageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Variante" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,10,0" />
                <ComboBox x:Name="VariantCombo" Grid.Column="1" SelectionChanged="VariantCombo_SelectionChanged">
                    <ComboBoxItem Content="SC — Sans chant" Tag="SC" IsSelected="True" />
                    <ComboBoxItem Content="EP — Entité panneau" Tag="EP" />
                </ComboBox>
                <TextBlock Grid.Column="3" Text="Compteur" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,10,0" />
                <TextBox x:Name="CounterText" Grid.Column="4" IsReadOnly="True" TextAlignment="Center" />
                <TextBox x:Name="PackageLabelText" Grid.Column="6" ToolTip="Libellé du package, par exemple Caisson_Basique" TextChanged="PackageLabelText_TextChanged" />
                <TextBlock x:Name="PackageNamePreview" Grid.Column="7" Margin="14,0" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="8" Content="Analyser la source" Style="{StaticResource PrimaryButton}" Click="ScanButton_Click" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="255" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="13">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Margin="4,2,4,12">
                        <TextBlock Text="Bibliothèques" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Filtrer par bibliothèque ou famille" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" />
                    </StackPanel>
                    <TreeView x:Name="LibraryTree" Grid.Row="1" SelectedItemChanged="LibraryTree_SelectedItemChanged" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="13">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="2,0,2,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchText" ToolTip="Rechercher un composant" TextChanged="SearchText_TextChanged" />
                        <Button Grid.Column="1" Content="Basculer la sélection" Margin="10,0,0,0" Click="ToggleSelectedRowsButton_Click" />
                        <Button Grid.Column="2" Content="Tout retirer" Margin="8,0,0,0" Click="ClearSelectionButton_Click" />
                    </Grid>
                    <DataGrid x:Name="ComponentsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False" SelectionMode="Extended" SelectionUnit="FullRow" AlternationCount="2" SelectionChanged="ComponentsGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="✓" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="42" />
                            <DataGridTextColumn Header="Bibliothèque" Binding="{Binding Library}" Width="125" IsReadOnly="True" />
                            <DataGridTextColumn Header="Famille" Binding="{Binding Family}" Width="110" IsReadOnly="True" />
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="135" IsReadOnly="True" />
                            <DataGridTextColumn Header="Composant" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Liés" Binding="{Binding AssociatedCount}" Width="55" IsReadOnly="True" />
                            <DataGridTextColumn Header="État" Binding="{Binding Status}" Width="85" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="4" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="16">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="190"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Aperçu du composant" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="PNG généré par TopSolid lorsqu’il existe" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,10" />
                    </StackPanel>
                    <Border Grid.Row="1" Background="#07101F" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="8">
                        <Grid>
                            <Image x:Name="PreviewImage" Stretch="Uniform" />
                            <TextBlock x:Name="NoPreviewText" Text="Aucun aperçu disponible" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="2" Margin="0,15,0,8">
                        <TextBlock x:Name="DetailName" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="DetailPath" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" />
                    </StackPanel>
                    <ListBox x:Name="AssociatedFilesList" Grid.Row="3" Background="Transparent" Foreground="{StaticResource TextBrush}" BorderThickness="0" FontSize="11" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4" Background="#0B2638" BorderBrush="#155E75" BorderThickness="1" CornerRadius="13" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="Sélectionne une variante puis analyse la source." Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="SelectedSummary" Margin="20,0,0,0" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                </StackPanel>
                <ProgressBar x:Name="ScanProgress" Grid.Column="1" Width="180" Height="6" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,14,0" />
                <Button Grid.Column="2" Content="Générer le rapport de simulation" Style="{StaticResource PrimaryButton}" Click="BuildReportButton_Click" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
