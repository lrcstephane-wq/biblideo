<UserControl x:Class="Biblideo.App.Views.ProductPackageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Biblideo.App.Controls"
             Background="{StaticResource BackgroundBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <ItemsPanelTemplate x:Key="ComponentListItemsPanel"><VirtualizingStackPanel /></ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="ComponentMosaicItemsPanel"><controls:VirtualizingWrapPanel TargetItemWidth="265" ItemHeight="218" Spacing="10" /></ItemsPanelTemplate>

        <Style x:Key="StepButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Padding" Value="13,9" /><Setter Property="Margin" Value="0,0,8,0" /><Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        </Style>
        <Style x:Key="FilterButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="10,5" /><Setter Property="Margin" Value="0,0,7,0" /><Setter Property="FontSize" Value="12" /></Style>
        <Style x:Key="LibraryListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="Margin" Value="0,2" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="LibraryItemBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="4,2"><ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" /></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="LibraryItemBorder" Property="Background" Value="#23354A" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="LibraryItemBorder" Property="Background" Value="#203D61" /><Setter TargetName="LibraryItemBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="BasketListItemStyle" TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="Background" Value="Transparent" /><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#24466E" /></Trigger></Style.Triggers></Style>
        <Style x:Key="ComponentListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Margin" Value="0,0,0,7" /><Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="CardBorder" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10"><ContentPresenter TextElement.Foreground="{StaticResource TextBrush}" /></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CardBorder" Property="Background" Value="#26374B" /><Setter TargetName="CardBorder" Property="BorderBrush" Value="#526A85" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="CardBorder" Property="Background" Value="#27496F" /><Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" /><Setter TargetName="CardBorder" Property="BorderThickness" Value="2" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ComponentMosaicItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource ComponentListItemStyle}"><Setter Property="Margin" Value="0" /><Setter Property="Height" Value="218" /></Style>

        <!-- La vue ligne exploite désormais toute la largeur : identité, emplacement, fichiers et état. -->
        <DataTemplate x:Key="ComponentListTemplate">
            <Grid Height="76">
                <Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="1.35*" MinWidth="160" /><ColumnDefinition Width="1*" MinWidth="120" /><ColumnDefinition Width="1.15*" MinWidth="140" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                <Border Width="64" Height="64" Background="{StaticResource FieldBrush}" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><Grid><TextBlock Text="3D" Foreground="{StaticResource SubtleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /><Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="4" /></Grid></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,18,0"><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding TechnicalName}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" /><Border Background="#273B53" CornerRadius="8" Padding="7,2" Margin="0,5,0,0" HorizontalAlignment="Left"><TextBlock Text="{Binding Type}" Foreground="#A9CBF3" FontSize="10" /></Border></StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,18,0"><TextBlock Text="EMPLACEMENT" Style="{StaticResource EyebrowText}" /><TextBlock Text="{Binding LocationSummary}" Margin="0,5,0,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding FolderSummary}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" /></StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,18,0"><TextBlock Text="FICHIERS EMPORTÉS" Style="{StaticResource EyebrowText}" /><TextBlock Text="{Binding BundleSummary}" Margin="0,5,0,0" FontWeight="SemiBold" Foreground="#C8DBF2" /><TextBlock Text="{Binding TopFileName}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" /></StackPanel>
                <StackPanel Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center"><Border Background="#273B53" CornerRadius="11" Padding="9,4" HorizontalAlignment="Right"><TextBlock Text="{Binding SelectionBadge}" Foreground="#9BC5F6" FontSize="10" FontWeight="SemiBold" /></Border><TextBlock HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,7,0,0"><Run Text="{Binding FileCount, Mode=OneWay}" /><Run Text=" fichier(s)" /></TextBlock></StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ComponentMosaicTemplate">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="105" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border Background="{StaticResource FieldBrush}" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><Grid><TextBlock Text="APERÇU 3D" Foreground="{StaticResource SubtleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" /><Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="7" /></Grid></Border>
                <StackPanel Grid.Row="1" Margin="1,9,1,0"><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding LocationSummary}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding TechnicalName}" Foreground="{StaticResource SubtleBrush}" FontSize="9" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" /></StackPanel>
                <Grid Grid.Row="2" Margin="0,8,0,0"><TextBlock Text="{Binding SelectionBadge}" Foreground="#9BC5F6" FontSize="10" FontWeight="SemiBold" /><TextBlock HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="10"><Run Text="{Binding FileCount, Mode=OneWay}" /><Run Text=" fichiers" /></TextBlock></Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}" Margin="20,16,20,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <Border Style="{StaticResource ModernPanel}" Padding="14">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="PACKAGE EN PRÉPARATION" Style="{StaticResource EyebrowText}" /><TextBlock x:Name="PackageNamePreview" Margin="0,4,0,0" Foreground="#80B2F0" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><StackPanel Orientation="Horizontal" Margin="0,7,0,0"><Border Background="#203B5C" CornerRadius="12" Padding="9,4" Margin="0,0,8,0"><TextBlock x:Name="CounterBadgeText" Foreground="#A7C8F2" FontSize="10" FontWeight="SemiBold" /></Border><Border Background="#193D38" CornerRadius="12" Padding="9,4"><TextBlock x:Name="PackageModeBadgeText" Text="SIMULATION OBLIGATOIRE · COPIE PROTÉGÉE" Foreground="#8DDBBF" FontSize="10" FontWeight="SemiBold" /></Border></StackPanel></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="NewPackageButton" Content="＋ Nouveau package" Visibility="Collapsed" Margin="0,0,12,0" Click="NewPackageButton_Click" /><Button x:Name="VariantScButton" Content="SC · Sans chant" Style="{StaticResource PrimaryButton}" Click="VariantScButton_Click" Padding="14,8" /><Button x:Name="VariantEpButton" Content="EP · Entité panneau" Margin="8,0,0,0" Click="VariantEpButton_Click" Padding="14,8" /></StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="4" /></Grid.RowDefinitions>
            <UniformGrid Columns="4">
                <Button x:Name="Step1Button" Style="{StaticResource StepButtonStyle}" Click="Step1Button_Click"><StackPanel Orientation="Horizontal"><Border x:Name="Step1Circle" Background="{StaticResource AccentDarkBrush}" CornerRadius="14" Width="28" Height="28"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border><StackPanel Margin="10,0,0,0"><TextBlock Text="Identification" FontWeight="SemiBold" /><TextBlock Text="Variante et nom" Foreground="{StaticResource MutedBrush}" FontSize="11" /></StackPanel></StackPanel></Button>
                <Button x:Name="Step2Button" Style="{StaticResource StepButtonStyle}" Click="Step2Button_Click"><StackPanel Orientation="Horizontal"><Border x:Name="Step2Circle" Background="#24344D" CornerRadius="14" Width="28" Height="28"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border><StackPanel Margin="10,0,0,0"><TextBlock Text="Sélection" FontWeight="SemiBold" /><TextBlock Text="Composer le pack" Foreground="{StaticResource MutedBrush}" FontSize="11" /></StackPanel></StackPanel></Button>
                <Button x:Name="Step3Button" Style="{StaticResource StepButtonStyle}" Click="Step3Button_Click"><StackPanel Orientation="Horizontal"><Border x:Name="Step3Circle" Background="#24344D" CornerRadius="14" Width="28" Height="28"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border><StackPanel Margin="10,0,0,0"><TextBlock Text="Vérification" FontWeight="SemiBold" /><TextBlock Text="Contrôler avant rapport" Foreground="{StaticResource MutedBrush}" FontSize="11" /></StackPanel></StackPanel></Button>
                <Button x:Name="Step4Button" Style="{StaticResource StepButtonStyle}" Click="Step4Button_Click"><StackPanel Orientation="Horizontal"><Border x:Name="Step4Circle" Background="#24344D" CornerRadius="14" Width="28" Height="28"><TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border><StackPanel Margin="10,0,0,0"><TextBlock Text="Simulation" FontWeight="SemiBold" /><TextBlock Text="Rapport HTML" Foreground="{StaticResource MutedBrush}" FontSize="11" /></StackPanel></StackPanel></Button>
            </UniformGrid>
            <ProgressBar x:Name="StepProgress" Grid.Row="1" Minimum="0" Maximum="100" Value="25" Height="3" Margin="4,0" />
        </Grid>

        <Grid Grid.Row="4">
            <!-- 1. Identification -->
            <Grid x:Name="IdentificationPanel" HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="1120" Margin="0,18,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="0.76*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="1.24*" /></Grid.ColumnDefinitions>
                <Border Background="#153F72" CornerRadius="14" Padding="28"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel><Border Width="48" Height="48" CornerRadius="24" Background="#2E69B3" HorizontalAlignment="Left"><TextBlock Text="01" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="Préparer un package produit" Foreground="White" FontSize="25" FontWeight="SemiBold" Margin="0,20,0,0" TextWrapping="Wrap" /><TextBlock Text="Crée un nouveau package ou rouvre un package à déployer pour compléter sa sélection." Foreground="#C6D7EA" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="20" /></StackPanel><StackPanel Grid.Row="2" Margin="0,30,0,0"><TextBlock Text="✓  SC ou EP, jamais les deux" Foreground="#E6F0FB" Margin="0,0,0,10" /><TextBlock Text="✓  Compteur proposé mais modifiable" Foreground="#E6F0FB" Margin="0,0,0,10" /><TextBlock Text="✓  Bibliothèques sources en lecture seule" Foreground="#E6F0FB" Margin="0,0,0,18" /><Button Content="Gérer les packages existants  →" Background="#214F82" BorderBrush="#6BA0D8" HorizontalAlignment="Stretch" Click="ManageExistingPackagesButton_Click" /></StackPanel></Grid></Border>
                <Border Grid.Column="2" Style="{StaticResource ModernPanel}" Padding="26"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="20" /><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="Auto" /><RowDefinition Height="20" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel><TextBlock Text="Identification" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="Le nom complet est généré automatiquement dans le bandeau." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0" /></StackPanel>
                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Compteur" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,6" /><TextBox x:Name="CounterText" TextAlignment="Center" FontWeight="SemiBold" MaxLength="3" TextChanged="CounterText_TextChanged" ToolTip="Valeur proposée automatiquement, modifiable de 000 à 999" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Libellé du package" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,6" /><TextBox x:Name="PackageLabelText" ToolTip="Par exemple Caisson_Basique" TextChanged="PackageLabelText_TextChanged" /></StackPanel></Grid>
                    <StackPanel Grid.Row="4"><TextBlock Text="Bibliothèque source" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,6" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="SourcePathText" TextChanged="SourcePathText_TextChanged" ToolTip="Chemin utilisé pour cette analyse" /><Button x:Name="BrowseSourceButton" Grid.Column="1" Content="Parcourir" Margin="8,0,0,0" Padding="11,7" Click="BrowseSourceButton_Click" /><Button Grid.Column="2" Content="↗ Ouvrir" Margin="8,0,0,0" Padding="11,7" Click="OpenSourceButton_Click" ToolTip="Ouvrir dans l’Explorateur Windows" /></Grid></StackPanel>
                    <Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="IdentityStatusText" Text="Prêt à analyser la bibliothèque en lecture seule." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" /><ProgressBar x:Name="IdentityScanProgress" IsIndeterminate="True" Visibility="Collapsed" Height="4" Width="220" HorizontalAlignment="Left" Margin="0,8,0,0" /></StackPanel><Button Grid.Column="1" Content="Analyser la bibliothèque  →" Style="{StaticResource PrimaryButton}" Margin="16,0,0,0" Click="ScanButton_Click" Padding="17,10" /></Grid>
                </Grid></Border>
            </Grid>

            <!-- 2. Atelier de sélection -->
            <Grid x:Name="SelectionPanel" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="10" /><RowDefinition Height="76" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid x:Name="SelectionWorkspace"><Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ModernPanel}" Padding="13"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel Margin="2,0,2,10"><TextBlock Text="Bibliothèques" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Une bibliothèque active à la fois" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" /></StackPanel><ListBox x:Name="LibraryList" Grid.Row="1" ItemContainerStyle="{StaticResource LibraryListItemStyle}" SelectionChanged="LibraryList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListBox.ItemTemplate><DataTemplate><Grid Margin="5,6"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="3" /></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" /><Border Grid.Column="1" Background="#203B5C" CornerRadius="9" Padding="5,2" HorizontalAlignment="Right"><TextBlock Foreground="#A7C8F2" FontSize="9"><Run Text="{Binding SelectedCount, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding TotalCount, Mode=OneWay}" /></TextBlock></Border></Grid><ProgressBar Grid.Row="1" Minimum="0" Maximum="{Binding TotalCount}" Value="{Binding SelectedCount}" Height="2" Margin="0,5,0,0" /></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><Button Grid.Row="2" Content="Toutes les bibliothèques" Margin="0,10,0,0" Padding="8,6" Click="ResetLibraryFilterButton_Click" /></Grid></Border>
                    <Border Grid.Column="2" Style="{StaticResource ModernPanel}" Padding="13"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="260" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="ActiveLibraryTitle" Text="Catalogue" FontSize="18" FontWeight="SemiBold" /><TextBlock x:Name="VisibleCountText" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" /></StackPanel><TextBox x:Name="SearchText" Grid.Column="1" ToolTip="Rechercher par bibliothèque, famille, type ou composant" TextChanged="SearchText_TextChanged" /><Button x:Name="ListViewButton" Grid.Column="2" Content="☷ Liste" Margin="8,0,0,0" Padding="10,6" Click="ListViewButton_Click" /><Button x:Name="MosaicViewButton" Grid.Column="3" Content="▦ Mosaïque" Margin="6,0,0,0" Padding="10,6" Click="MosaicViewButton_Click" /><Button Grid.Column="4" Content="Tout sélectionner" Margin="8,0,0,0" Padding="10,6" Click="SelectVisibleButton_Click" /></Grid>
                        <Grid Grid.Row="1" Margin="0,11,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="FamilyFiltersPanel" Orientation="Horizontal" /></ScrollViewer><ComboBox x:Name="TypeFilterCombo" Grid.Column="1" SelectionChanged="TypeFilterCombo_SelectionChanged" /><Button Grid.Column="2" Content="Retirer les éléments affichés" ToolTip="Retire du package uniquement les composants actuellement visibles avec ces filtres" Margin="8,0,0,0" Padding="10,6" Click="ClearVisibleButton_Click" /></Grid>
                        <ListBox x:Name="ComponentsList" Grid.Row="3" SelectionMode="Extended" SelectionChanged="ComponentsList_SelectionChanged" ItemContainerStyle="{StaticResource ComponentListItemStyle}" ItemTemplate="{StaticResource ComponentListTemplate}" ItemsPanel="{StaticResource ComponentListItemsPanel}" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" />
                    </Grid></Border>
                    <Border x:Name="BasketDrawer" Grid.Column="2" Panel.ZIndex="20" Visibility="Collapsed" HorizontalAlignment="Right" Width="470" Background="#182433" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="13" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid><TextBlock Text="Contenu du package" FontSize="20" FontWeight="SemiBold" /><Button Content="Replier" HorizontalAlignment="Right" Padding="9,5" Click="CloseBasketButton_Click" /></Grid><TextBlock x:Name="BasketSummaryText" Grid.Row="1" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0" /><ListBox x:Name="SelectionBasket" Grid.Row="2" Margin="0,12" ItemContainerStyle="{StaticResource BasketListItemStyle}" SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><Border Background="#203B5C" CornerRadius="7" Padding="9,5" Margin="0,7,0,4"><TextBlock Text="{Binding Name}" Foreground="#A7C8F2" FontWeight="SemiBold" /></Border></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="38" Height="38" Background="{StaticResource FieldBrush}" CornerRadius="6"><Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="3" /></Border><StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding LocationSummary}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" /></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="10"><Run Text="{Binding FileCount, Mode=OneWay}" /><Run Text=" fichiers" /></TextBlock><Button Content="Retirer" Tag="{Binding}" Padding="7,3" Margin="0,4,0,0" Click="RemoveBasketItemButton_Click" /></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Retirer la sélection" Click="RemoveFromBasketButton_Click" /><Button Content="Vider le package" Margin="8,0,0,0" Click="ClearSelectionButton_Click" /></StackPanel></Grid></Border>
                </Grid>
                <Border x:Name="PreviewStrip" Grid.Row="2" Style="{StaticResource ModernPanel}" Padding="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="320" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="58" Height="58" Background="{StaticResource FieldBrush}" CornerRadius="8"><Grid><TextBlock x:Name="NoPreviewText" Text="3D" Foreground="{StaticResource SubtleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /><Image x:Name="PreviewImage" Stretch="Uniform" Margin="4" /></Grid></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="DetailName" Text="Sélectionne un composant" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="DetailPath" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,5,14,0" /></StackPanel><ListBox x:Name="AssociatedFilesList" Grid.Column="2" Foreground="{StaticResource MutedBrush}" FontSize="10" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Border Background="#26374B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="8,4" Margin="0,2,6,2"><TextBlock Text="{Binding}" /></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
                <Border Grid.Row="4" Background="#1D334D" BorderBrush="#456B95" BorderThickness="1" CornerRadius="12" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="SelectedSummary" FontWeight="SemiBold" Foreground="#B8D3F2" /><TextBlock x:Name="SelectionStatusText" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="UndoSelectionButton" Content="↶  Annuler" IsEnabled="False" Click="UndoSelectionButton_Click" /><Button Content="Voir le panier" Margin="8,0,0,0" Click="OpenBasketButton_Click" /><Button x:Name="VerifyButton" Content="Vérifier le package  →" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="GoToVerificationButton_Click" /></StackPanel></Grid></Border>
            </Grid>

            <!-- 3. Vérification : toute la largeur utile, arbre et synthèse côte à côte. -->
            <Grid x:Name="VerificationPanel" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid><StackPanel><TextBlock Text="Vérification avant simulation" FontSize="23" FontWeight="SemiBold" /><TextBlock Text="Contrôle le contenu réel, bibliothèque par bibliothèque, avant de générer le rapport." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" /></StackPanel><Button Content="←  Modifier la sélection" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BackToSelectionButton_Click" /></Grid>
                <UniformGrid Grid.Row="2" Columns="4"><Border Style="{StaticResource ModernPanel}" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="COMPOSANTS" Style="{StaticResource EyebrowText}" /><TextBlock x:Name="VerificationComponentCount" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel></Border><Border Style="{StaticResource ModernPanel}" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="FICHIERS" Style="{StaticResource EyebrowText}" /><TextBlock x:Name="VerificationFileCount" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel></Border><Border Style="{StaticResource ModernPanel}" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="BIBLIOTHÈQUES" Style="{StaticResource EyebrowText}" /><TextBlock x:Name="VerificationLibraryCount" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel></Border><Border Style="{StaticResource ModernPanel}" Padding="14"><StackPanel><TextBlock Text="AVERTISSEMENTS" Style="{StaticResource EyebrowText}" /><TextBlock x:Name="VerificationWarningCount" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel></Border></UniformGrid>
                <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="2.2*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="0.8*" MinWidth="300" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ModernPanel}" Padding="15"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><StackPanel><TextBlock Text="Contenu exact du package" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Les bibliothèques sont ouvertes ; déplie un composant pour voir ses .top, .png, .bmp et .cat. Tu peux le retirer ici." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap" /></StackPanel><TreeView x:Name="VerificationTree" Grid.Row="1" Margin="0,12,0,0" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><TreeView.ItemContainerStyle><Style TargetType="TreeViewItem"><Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" /><Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="Padding" Value="2" /></Style></TreeView.ItemContainerStyle><TreeView.ItemTemplate><HierarchicalDataTemplate ItemsSource="{Binding Children}"><Grid Margin="2,4"><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Glyph}" Foreground="#8CB9F2" FontSize="14" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Margin="3,0,12,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" /></StackPanel><Border Grid.Column="2" Background="#263B55" CornerRadius="8" Padding="7,2" Margin="0,0,8,0" VerticalAlignment="Center"><TextBlock Text="{Binding Badge}" Foreground="#A7C8F2" FontSize="9" FontWeight="SemiBold" /></Border><Button Grid.Column="3" Content="Retirer" Tag="{Binding Component}" Visibility="{Binding IsRemovable, Converter={StaticResource BoolToVisibilityConverter}}" Padding="8,4" VerticalAlignment="Center" Click="RemoveVerificationComponentButton_Click" /></Grid></HierarchicalDataTemplate></TreeView.ItemTemplate></TreeView></Grid></Border>
                    <Border Grid.Column="2" Style="{StaticResource ModernPanel}" Padding="17"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel><TextBlock Text="Prêt à simuler ?" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="Dernier contrôle avant production du rapport." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0" /></StackPanel><StackPanel Grid.Row="2"><TextBlock Text="DESTINATION SIMULÉE" Style="{StaticResource EyebrowText}" /><TextBlock x:Name="VerificationTargetPathText" Foreground="#C7DAF0" Margin="0,7,0,0" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" /></StackPanel><Border Grid.Row="4" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="12" VerticalAlignment="Top"><StackPanel><TextBlock Text="ÉTAT DES CONTRÔLES" Style="{StaticResource EyebrowText}" /><TextBlock x:Name="VerificationStatusText" FontWeight="SemiBold" Foreground="#C7DCF6" TextWrapping="Wrap" Margin="0,8,0,0" /><TextBlock Text="Cette étape reste en lecture seule. La copie ne sera proposée qu’après validation du rapport." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0" /><StackPanel x:Name="ModificationModePanel" Visibility="Collapsed" Margin="0,14,0,0"><TextBlock Text="FICHIERS DÉJÀ PRÉSENTS" Style="{StaticResource EyebrowText}" /><ComboBox x:Name="ModificationCopyModeCombo" SelectedIndex="0" Margin="0,7,0,0" SelectionChanged="ModificationCopyModeCombo_SelectionChanged"><ComboBoxItem Tag="Overwrite">Actualiser depuis la bibliothèque (recommandé)</ComboBoxItem><ComboBoxItem Tag="Preserve">Conserver les copies actuelles</ComboBoxItem></ComboBox></StackPanel></StackPanel></Border><Button Grid.Row="5" Content="Générer la simulation  →" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Padding="16,11" Click="BuildReportButton_Click" /></Grid></Border>
                </Grid>
            </Grid>

            <!-- 4. Rapport -->
            <Border x:Name="ReportPanel" Visibility="Collapsed" Style="{StaticResource ModernPanel}" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center" Width="760" MaxWidth="850">
                <StackPanel>
                    <Border Background="#193D38" CornerRadius="30" Width="60" Height="60" HorizontalAlignment="Left"><TextBlock Text="✓" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8DDBBF" /></Border>
                    <TextBlock x:Name="ReportTitleText" Text="Simulation terminée" FontSize="26" FontWeight="SemiBold" Margin="0,18,0,0" />
                    <TextBlock x:Name="ReportDescriptionText" Text="Le rapport est prêt. Aucun fichier métier n’a été créé, copié, déplacé ou supprimé." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0" />
                    <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,18,0,0"><TextBlock x:Name="LastReportNameText" Foreground="#8CB9F2" FontFamily="Consolas" TextWrapping="Wrap" /></Border>
                    <Border x:Name="RealCopyPanel" Background="#152E2B" BorderBrush="#337E69" BorderThickness="1" CornerRadius="11" Padding="15" Margin="0,16,0,0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock x:Name="RealCopyHeaderText" Text="COPIE RÉELLE CONTRÔLÉE" Foreground="#78D8B8" FontSize="10" FontWeight="Bold" /><TextBlock x:Name="RealCopyStatusText" Text="Prêt à créer le package : copies uniquement, aucun écrasement." Margin="0,6,18,0" TextWrapping="Wrap" /><ProgressBar x:Name="RealCopyProgress" Minimum="0" Maximum="100" Height="5" Visibility="Collapsed" Margin="0,10,18,0" /></StackPanel>
                            <Button x:Name="CreateRealPackageButton" Grid.Column="1" Content="Créer le package  →" Style="{StaticResource PrimaryButton}" Padding="16,10" VerticalAlignment="Center" Click="CreateRealPackageButton_Click" />
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="Revenir à la sélection" Click="BackToSelectionButton_Click" /><Button Content="Afficher le rapport HTML" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="OpenLastReportButton_Click" /></StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
