<Window x:Class="Biblideo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Idéo Nexus" Height="900" Width="1480"
        Icon="/Biblideo;component/Assets/ideo-mark.png"
        MinHeight="720" MinWidth="1180" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary Source="Themes/NexusWorkspace.xaml" />
    </Window.Resources>
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavigationColumn" Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="{StaticResource NexusRailBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,2,0,18" LastChildFill="True">
                    <Button DockPanel.Dock="Left" Content="&#xE700;" Style="{StaticResource NexusIconButton}"
                            AutomationProperties.Name="Réduire ou développer la navigation"
                            ToolTip="Réduire ou développer la navigation" Click="ToggleNavigation_Click" />
                    <StackPanel x:Name="BrandPanel" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Idéo Nexus" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="Idéo Solutions" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                    </StackPanel>
                </DockPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="NavigationPanel">
                        <Button Tag="Home" Content="Accueil" ToolTip="Accueil" AutomationProperties.Name="Accueil"
                                AutomationProperties.HelpText="Vue d’ensemble" Click="NavigationButton_Click"
                                Style="{StaticResource NexusNavButton}" />
                        <Button Tag="Clients" Content="Clients" ToolTip="Clients" AutomationProperties.Name="Clients"
                                Click="NavigationButton_Click" Style="{StaticResource NexusNavButton}" />
                        <Button Tag="Applications" Content="Applications" ToolTip="Applications" AutomationProperties.Name="Applications"
                                Click="NavigationButton_Click" Style="{StaticResource NexusNavButton}" />
                        <Button Tag="Licenses" Content="Licences Biblidéo" ToolTip="Licences Biblidéo" AutomationProperties.Name="Licences Biblidéo"
                                Click="NavigationButton_Click" Style="{StaticResource NexusNavButton}" />
                        <Button Tag="AtlasLicenses" Content="Licences Atlas" ToolTip="Licences Atlas" AutomationProperties.Name="Licences Atlas"
                                Click="NavigationButton_Click" Style="{StaticResource NexusNavButton}" />
                        <Separator Margin="4,14,4,12" Background="{StaticResource BorderBrush}" />
                        <TextBlock x:Name="WorkshopHeading" Text="ATELIER BIBLIDÉO" FontSize="10" FontWeight="SemiBold"
                                   Margin="10,0,0,6" Foreground="{StaticResource MutedBrush}" />
                        <Button Tag="Product" Content="Packages produit" ToolTip="Packages produit" AutomationProperties.Name="Packages produit"
                                Click="NavigationButton_Click" Style="{StaticResource NexusNavButton}" />
                        <Button Tag="Monthly" Content="Packs mensuels" ToolTip="Packs mensuels" AutomationProperties.Name="Packs mensuels"
                                Click="NavigationButton_Click" Style="{StaticResource NexusNavButton}" />
                        <Button Tag="Deployment" Content="Déploiement" ToolTip="Déploiement" AutomationProperties.Name="Déploiement"
                                Click="NavigationButton_Click" Style="{StaticResource NexusNavButton}" />
                    </StackPanel>
                </ScrollViewer>
                <Button x:Name="SettingsButton" Grid.Row="2" Margin="0,8,0,0" Tag="Settings" Content="Paramètres"
                        ToolTip="Paramètres" AutomationProperties.Name="Paramètres"
                        Click="NavigationButton_Click" Style="{StaticResource NexusNavButton}" />
            </Grid>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Background="{StaticResource NexusRailBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <DockPanel Margin="22,12" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock x:Name="VersionText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        <Button x:Name="UpdateButton" Content="Mise à jour" Margin="12,0,0,0" Padding="10,6"
                                Click="UpdateButton_Click" ToolTip="Rechercher une version de l’application" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" Text="Accueil" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock x:Name="AppModeText" Visibility="Collapsed" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource WarningBrush}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <ContentControl x:Name="PageContent" Grid.Row="1" IsTabStop="False"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>
    </Grid>
</Window>
