<Window x:Class="Biblideo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Biblidéo — Post-production" Height="900" Width="1500"
        MinHeight="720" MinWidth="1180" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#09172A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="8,10,8,30">
                    <TextBlock Text="BIBLIDÉO" FontSize="25" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="POST-PRODUCTION" Margin="1,3,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <Border Grid.Row="1" Background="#173250" CornerRadius="8" Padding="10,7" Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#34D399" Margin="0,0,8,0" />
                        <TextBlock Text="V0 · SIMULATION STRICTE" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Row="2">
                    <Button x:Name="HomeButton" Content="⌂  Vue d’ensemble" Tag="Home" Click="NavigationButton_Click" HorizontalContentAlignment="Left" Margin="0,3" />
                    <Button x:Name="ProductButton" Content="▦  Packages produit" Tag="Product" Click="NavigationButton_Click" HorizontalContentAlignment="Left" Margin="0,3" Background="#0E7490" />
                    <Button Content="▣  Packs mensuels" Tag="Monthly" Click="NavigationButton_Click" HorizontalContentAlignment="Left" Margin="0,3" />
                    <Button Content="⇢  Déploiement" Tag="Deployment" Click="NavigationButton_Click" HorizontalContentAlignment="Left" Margin="0,3" />
                    <Button Content="♙  Clients" Tag="Clients" Click="NavigationButton_Click" HorizontalContentAlignment="Left" Margin="0,3" />
                    <Button Content="◇  Licences" Tag="Licenses" Click="NavigationButton_Click" HorizontalContentAlignment="Left" Margin="0,3" />
                </StackPanel>
                <StackPanel Grid.Row="3">
                    <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,12" />
                    <Button Content="⚙  Paramètres" Tag="Settings" Click="NavigationButton_Click" HorizontalContentAlignment="Left" />
                    <TextBlock Text="Idéo Solutions" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="10,14,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="74" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Background="#081426">
                <Grid Margin="28,0">
                    <TextBlock x:Name="PageTitle" Text="Packages produit" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="Aucune écriture dans les dossiers métier" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                </Grid>
            </Border>
            <ContentControl x:Name="PageContent" Grid.Row="1" />
        </Grid>
    </Grid>
</Window>
